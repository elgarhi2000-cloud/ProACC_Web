@inject IUserAccessService Access
@using System.Globalization
@using BlazorApp1.Services
@inject IMasterDataService MasterDataService

<div class="master-data-manager" dir="rtl">
    @if (definition is null)
    {
        <div class="alert alert-info">جاري تحميل القسم...</div>
    }
    else if (!(UsesInlineEditor && editorOpen))
    {
        <div class="card master-data-card">
            <div class="card-header master-data-header">
                <div class="master-data-title">
                    <span class="master-data-title-icon"><i class="bi @definition.Icon"></i></span>
                    <div>
                        <h5 class="mb-0">@(TitleOverride ?? definition.Title)</h5>
                        <small>عرض وإدارة سجلات @definition.Title</small>
                    </div>
                </div>
                @if (SectionKey is "employees" or "holidays" or "payroll")
                {
                    <ReportPrintButton Kind="@SectionKey" BuildReport="BuildPrintReport" Disabled="@(isLoading || isSaving || filteredRows.Count == 0)" ToolbarSection="@ToolbarSection" />
                }
                @if (CanCreate)
                {
                    <button class="btn btn-primary" type="button" @onclick="OpenCreate">
                        <i class="bi bi-plus-lg"></i>
                        إضافة سجل
                    </button>
                }
                else if (rows.Count > 0)
                {
                    <button class="btn btn-primary" type="button" @onclick="() => OpenEdit(rows[0])">
                        <i class="bi bi-pencil-square"></i>
                        تعديل البيانات
                    </button>
                }
            </div>

            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="alert @(messageIsError ? "alert-danger" : "alert-success") master-data-message">@message</div>
                }

                @if (IsCompaniesSection && rows.Count > 0)
                {
                    <div class="company-profile-banner">
                        <div class="company-logo-frame">
                            @if (!string.IsNullOrWhiteSpace(CompanyLogoSource))
                            {
                                <img src="@CompanyLogoSource" alt="شعار @CompanyDisplayName" />
                            }
                            else
                            {
                                <i class="bi bi-buildings" aria-hidden="true"></i>
                            }
                        </div>
                        <div class="company-profile-info">
                            <span>شعار المنشأة</span>
                            <strong>@CompanyDisplayName</strong>
                            <small>@(string.IsNullOrWhiteSpace(CompanyLogoSource) ? "لا يوجد شعار محفوظ" : "الشعار المحفوظ في بيانات المنشأة")</small>
                        </div>
                        <span class="company-edit-only-badge"><i class="bi bi-shield-lock"></i> التعديل فقط</span>
                    </div>
                }

                @if (!IsCompaniesSection)
                {
                    <div class="section-search-bar master-data-toolbar">
                        <input aria-label="ابحث في سجلات @definition.Title" type="search" class="form-control section-search-input" value="@searchText" @oninput="OnSearchInput"
                               placeholder="ابحث في سجلات @definition.Title" />
                        <button class="btn section-search-btn" type="button" @onclick="ApplySearch">
                            <i class="bi bi-search"></i>بحث
                        </button>
                        <button class="btn records-refresh-btn" type="button" @onclick="LoadAsync" disabled="@isLoading">
                            <i class="bi bi-arrow-repeat"></i>تحديث
                        </button>
                        @if (UseCardLayout)
                        {
                            <div class="view-mode-switch" role="group" aria-label="طريقة عرض السجلات">
                                <button type="button" class="view-mode-btn @(cardViewActive ? "active" : null)"
                                        title="عرض كبطاقات" aria-label="عرض السجلات كبطاقات" aria-pressed="@cardViewActive"
                                        @onclick="() => SetCardView(true)">
                                    <i class="bi bi-grid-3x3-gap"></i><span>بطاقات</span>
                                </button>
                                <button type="button" class="view-mode-btn @(!cardViewActive ? "active" : null)"
                                        title="عرض كجدول بيانات" aria-label="عرض السجلات كجدول بيانات" aria-pressed="@(!cardViewActive)"
                                        @onclick="() => SetCardView(false)">
                                    <i class="bi bi-table"></i><span>جدول</span>
                                </button>
                            </div>
                        }
                        <span class="badge records-count-badge">@filteredRows.Count سجل</span>
                    </div>
                }

                @if (rows.Count == 500 && !isLoading)
                {
                    <div class="alert alert-info" role="status">يعرض هذا القسم أحدث 500 سجل؛ البحث ضمن السجلات المحمّلة فقط.</div>
                }

                @if (isLoading)
                {
                    <div class="master-data-empty"><span class="spinner-border spinner-border-sm"></span> جاري تحميل السجلات...</div>
                }
                else if (filteredRows.Count == 0)
                {
                    <div class="master-data-empty"><i class="bi bi-inbox"></i><span>لا توجد سجلات مطابقة.</span></div>
                }
                else if (IsCompaniesSection)
                {
                    @foreach (var group in CompanyDisplayFields.GroupBy(item => GetCompanyGroup(item.Column)))
                    {
                        <section class="employee-editor-group">
                            <h6 class="employee-group-title">@group.Key</h6>
                            <div class="company-details-grid">
                                @foreach (var field in group)
                                {
                                    <div class="company-detail-field @GetCompanyFieldClass(field)">
                                        <span>@field.Label</span>
                                        <strong>@FormatDisplay(rows[0], field)</strong>
                                    </div>
                                }
                            </div>
                        </section>
                    }
                }
                else if (UseCardLayout && cardViewActive)
                {
                    <div class="master-records-grid">
                        @foreach (var row in filteredRows)
                        {
                            <article class="master-record-card">
                                <div class="employee-card-head">
                                    <div class="employee-avatar" aria-hidden="true">@GetInitials(row)</div>
                                    <div class="employee-identity">
                                        <h6>@GetColumnDisplay(row, CardTitleColumn)</h6>
                                        <span>@GetColumnDisplay(row, CardSubtitleColumn)</span>
                                    </div>
                                    <span class="employee-number">#@row.Id</span>
                                </div>

                                <div class="employee-card-body">
                                    @foreach (var detail in CardDetails)
                                    {
                                        <div class="employee-detail @(detail.Wide ? "employee-detail-wide" : null)">
                                            <i class="bi @detail.Icon"></i>
                                            <span>@detail.Label</span>
                                            <strong class="@(detail.Numeric ? "master-number" : null)">@GetColumnDisplay(row, detail.Column)</strong>
                                        </div>
                                    }
                                </div>

                                <div class="employee-card-footer">
                                    <span class="employee-status-dot @(!IsCardRecordActive(row) ? "inactive" : null)"><i></i>@GetCardFooterText(row)</span>
                                    <div class="entry-actions" role="group" aria-label="إجراءات السجل @GetColumnDisplay(row, CardTitleColumn)">
                                        @if (EnableSelection)
                                        {
                                            <button type="button" class="action-btn action-select" title="اختيار الموظف" aria-label="اختيار الموظف" @onclick="() => SelectRowAsync(row)">
                                                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                            </button>
                                        }
                                        <button type="button" class="action-btn action-edit" title="تعديل الموظف" aria-label="تعديل الموظف" @onclick="() => OpenEdit(row)">
                                            <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                        </button>
                                        @if (CanDelete)
                                        {
                                            <button type="button" class="action-btn action-delete" title="حذف السجل" aria-label="حذف السجل" @onclick="() => OpenDelete(row)">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="table-responsive master-data-table-wrap">
                        <table class="table table-hover align-middle master-data-table">
                            <thead>
                            <tr>
                                <th>
                                    <button class="sort-header @(sortColumn == definition.KeyColumn ? "active" : null)" @onclick="() => SortBy(definition.KeyColumn)">
                                        <span>@(IsPayrollList ? "رقم المسير" : "الرقم")</span><i class="@GetSortIcon(definition.KeyColumn)"></i>
                                    </button>
                                </th>
                                @foreach (var field in TableFields)
                                {
                                    <th>
                                        <button class="sort-header @(sortColumn == field.Column ? "active" : null)" @onclick="() => SortBy(field.Column)">
                                            <span>@field.Label</span><i class="@GetSortIcon(field.Column)"></i>
                                        </button>
                                    </th>
                                }
                                <th class="actions-heading"><span class="actions-heading-label">إجراءات</span></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var row in filteredRows)
                            {
                                <tr class="@(selectedRowId == row.Id ? "selected-master-row" : null)">
                                    <td class="master-key-cell">#@row.Id</td>
                                    @foreach (var field in TableFields)
                                    {
                                        <td class="@(field.Kind is MasterFieldKind.Decimal ? "text-nowrap master-number" : null)">
                                            @if (field.Kind == MasterFieldKind.Boolean)
                                            {
                                                <span class="badge @(IsTrue(row, field.Column) ? "bg-success" : "bg-secondary")">@(IsTrue(row, field.Column) ? "نعم" : "لا")</span>
                                            }
                                            else
                                            {
                                                @FormatDisplay(row, field)
                                            }
                                        </td>
                                    }
                                    <td>
                                        <div class="entry-actions master-actions">
                                            @if (EnableSelection)
                                            {
                                                <button type="button" class="action-btn action-select" title="اختيار السجل" aria-label="اختيار السجل رقم @row.Id" @onclick="() => SelectRowAsync(row)">
                                                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                                </button>
                                            }
                                            <button type="button" class="action-btn action-edit" title="تعديل السجل" aria-label="تعديل السجل رقم @row.Id" @onclick="() => OpenEdit(row)">
                                                <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                            </button>
                                            @if (CanDelete)
                                            {
                                                <button type="button" class="action-btn action-delete" title="حذف السجل" aria-label="حذف السجل رقم @row.Id" @onclick="() => OpenDelete(row)">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (editorOpen && definition is not null)
{
    <div class="@(UsesInlineEditor ? "employee-page-editor" : "crud-overlay")" dir="rtl" role="@(UsesInlineEditor ? "region" : "dialog")" aria-modal="@(UsesInlineEditor ? null : "true")" aria-label="@(editingId is null ? "إضافة سجل" : "تعديل سجل")">
        <div class="crud-card master-editor-card">
            <div class="crud-header">
                <div>
                    <h5 class="mb-1">@(IsEmployeesSection ? (editingId is null ? "إضافة موظف جديد" : "تعديل بيانات الموظف") : IsCompaniesSection ? "تعديل بيانات المنشأة" : IsContactCards ? (editingId is null ? "إضافة جهة تعامل جديدة" : "تعديل جهة التعامل") : (editingId is null ? "إضافة سجل جديد" : "تعديل السجل"))</h5>
                    <small>@(IsEmployeesSection ? "أكمل بيانات الموظف حسب المجموعات أدناه. الحقول المميزة بـ * مطلوبة." : definition.Title)</small>
                </div>
                <button class="btn btn-sm btn-light" type="button" @onclick="CloseEditor" disabled="@isSaving" aria-label="@(UsesInlineEditor ? "العودة إلى البيانات" : "إغلاق")"><i class="bi @(UsesInlineEditor ? "bi-arrow-right" : "bi-x-lg")"></i>@(UsesInlineEditor ? "العودة إلى البيانات" : "")</button>
            </div>
            <div class="crud-body master-editor-body">
                @if (!string.IsNullOrWhiteSpace(editorError))
                {
                    <div class="alert alert-danger master-data-message">@editorError</div>
                }
                @if (!definition.KeyIsIdentity && editingId is null)
                {
                    <div class="master-field">
                        <label class="form-label">رقم السجل <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" value="@editorKeyValue" @oninput="e => editorKeyValue = e.Value?.ToString() ?? string.Empty" />
                    </div>
                }

                @foreach (var group in EditorGroups)
                {
                    <section class="@(IsGroupedEditor ? "employee-editor-group" : null)">
                        @if (IsGroupedEditor)
                        {
                            <h6 class="employee-group-title">@group.Key</h6>
                        }
                <div class="master-editor-grid">
                    @if (IsContactCards && group.Key == "البيانات الأساسية")
                    {
                        <div class="master-field">
                            <label class="form-label" for="card-record-id">معرّف السجل</label>
                            <input id="card-record-id" class="form-control" value="@(editingId ?? "تلقائي عند الحفظ")" readonly />
                        </div>
                    }
                    @foreach (var field in group)
                    {
                        <div class="master-field @(field.Kind is MasterFieldKind.Multiline or MasterFieldKind.Image ? "master-field-wide" : null)">
                            <label class="form-label" for="@($"master-{SectionKey}-{field.Column}")">
                                @field.Label
                                @if (field.Required && !(editingId is not null && field.Kind == MasterFieldKind.Password))
                                {
                                    <span class="text-danger">*</span>
                                }
                            </label>

                            @switch (field.Kind)
                            {
                                case MasterFieldKind.Boolean:
                                    <label class="master-switch">
                                        <input id="@($"master-{SectionKey}-{field.Column}")" type="checkbox" disabled="@(SectionKey == "payroll" && field.Column == "Archive" && !Access.Has("Archive"))" checked="@GetEditorBool(field.Column)" @onchange="e => SetEditorBool(field.Column, e)" />
                                        <span>@(GetEditorBool(field.Column) ? "مفعّل" : "غير مفعّل")</span>
                                    </label>
                                    break;
                                case MasterFieldKind.Multiline:
                                    <textarea id="@($"master-{SectionKey}-{field.Column}")" class="form-control" rows="3" value="@GetEditorValue(field.Column)" @oninput="e => SetEditorValue(field.Column, e)"></textarea>
                                    break;
                                case MasterFieldKind.Date:
                                    <input id="@($"master-{SectionKey}-{field.Column}")" type="date" class="form-control" value="@GetEditorValue(field.Column)" @oninput="e => SetEditorValue(field.Column, e)" />
                                    break;
                                case MasterFieldKind.Integer:
                                    <input id="@($"master-{SectionKey}-{field.Column}")" type="number" step="1" class="form-control" value="@GetEditorValue(field.Column)" @oninput="e => SetEditorValue(field.Column, e)" />
                                    break;
                                case MasterFieldKind.Decimal:
                                    <input id="@($"master-{SectionKey}-{field.Column}")" type="number" step="0.01" class="form-control" value="@GetEditorValue(field.Column)" @oninput="e => SetEditorValue(field.Column, e)" />
                                    break;
                                case MasterFieldKind.Password:
                                    <input id="@($"master-{SectionKey}-{field.Column}")" type="password" class="form-control" value="@GetEditorValue(field.Column)" @oninput="e => SetEditorValue(field.Column, e)"
                                           placeholder="@(editingId is null ? "أدخل كلمة المرور" : "اتركها فارغة للاحتفاظ بكلمة المرور الحالية")" autocomplete="new-password" />
                                    break;
                                case MasterFieldKind.Lookup:
                                    @if (field.LookupTable == "ACC")
                                    {
                                        <AccountLookupSearch InputId="@($"master-{SectionKey}-{field.Column}")" Label="@field.Label"
                                                             Options="@GetLookupOptions(field.Column)" Value="@GetEditorValue(field.Column)"
                                                             ValueChanged="@(value => editorValues[field.Column] = value)" Disabled="@isSaving" />
                                    }
                                    else
                                    {
                                    <select id="@($"master-{SectionKey}-{field.Column}")" class="form-select" value="@GetEditorValue(field.Column)" @onchange="e => SetEditorValue(field.Column, e)">
                                        <option value="">-- اختر --</option>
                                        @foreach (var option in GetLookupOptions(field.Column))
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </select>
                                    }
                                    break;
                                case MasterFieldKind.Image:
                                    <div class="company-logo-editor">
                                        <div class="company-logo-editor-preview">
                                            @if (!string.IsNullOrWhiteSpace(GetEditorValue(field.Column)))
                                            {
                                                <img src="@GetEditorValue(field.Column)" alt="معاينة شعار المنشأة" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image"></i>
                                            }
                                        </div>
                                        <div class="company-logo-editor-controls">
                                            <strong>اختيار شعار جديد</strong>
                                            <small>PNG أو JPG أو GIF أو BMP أو WEBP، وبحجم لا يتجاوز 5 ميجابايت.</small>
                                            <InputFile class="form-control" accept="image/png,image/jpeg,image/gif,image/bmp,image/webp"
                                                       OnChange="@(e => OnImageSelectedAsync(field.Column, e))" />
                                        </div>
                                    </div>
                                    break;
                                default:
                                    <input id="@($"master-{SectionKey}-{field.Column}")" type="text" class="form-control" value="@GetEditorValue(field.Column)" @oninput="e => SetEditorValue(field.Column, e)" />
                                    break;
                            }
                        </div>
                    }
                </div>
                    </section>
                }
            </div>
            <div class="crud-footer">
                <button class="btn btn-light" type="button" @onclick="CloseEditor" disabled="@isSaving">إلغاء</button>
                <button class="btn btn-primary" type="button" @onclick="SaveAsync" disabled="@isSaving">
                    <i class="bi bi-check2-circle"></i>@(isSaving ? "جاري الحفظ..." : "حفظ")
                </button>
            </div>
        </div>
    </div>
}

@if (deleteRow is not null && definition is not null)
{
    <div class="crud-overlay" role="alertdialog" aria-modal="true" aria-label="تأكيد الحذف">
        <div class="crud-card master-delete-card">
            <div class="crud-header"><h5 class="mb-0">تأكيد حذف السجل</h5></div>
            <div class="crud-body">
                <p class="mb-2">هل تريد حذف السجل رقم <strong>#@deleteRow.Id</strong> من @definition.Title؟</p>
                <small class="text-muted">لن يتم الحذف إذا كان السجل مرتبطًا ببيانات أخرى.</small>
            </div>
            <div class="crud-footer">
                <button class="btn btn-light" @onclick="CloseDelete">إلغاء</button>
                <button class="btn btn-danger" @onclick="DeleteAsync" disabled="@isSaving"><i class="bi bi-trash"></i>حذف</button>
            </div>
        </div>
    </div>
}

<style>
    .master-data-card { overflow: visible; }
    .master-data-header { justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .master-data-title { min-width: 0; display: flex; align-items: center; gap: 11px; }
    .master-data-title-icon { width: 40px; height: 40px; display: grid; place-items: center; flex: 0 0 40px; color: var(--q-primary); background: var(--q-primary-soft); border-radius: 10px; }
    .master-data-title small { color: var(--q-muted); }
    .master-data-toolbar { margin-bottom: 14px; }
    .view-mode-switch { min-height: 40px; padding: 3px; display: inline-flex; align-items: center; gap: 2px; background: #f3f4f7; border: 1px solid var(--q-border); border-radius: 9px; }
    .view-mode-btn { min-height: 32px; padding: 5px 9px; display: inline-flex; align-items: center; justify-content: center; gap: 5px; color: var(--q-muted); background: transparent; border: 0; border-radius: 7px; font-family: inherit; font-size: .73rem; font-weight: 750; white-space: nowrap; transition: color .18s ease, background-color .18s ease, box-shadow .18s ease; }
    .view-mode-btn:hover { color: var(--q-primary); }
    .view-mode-btn.active { color: var(--q-primary); background: #fff; box-shadow: 0 2px 7px rgba(15, 23, 42, .09); }
    .view-mode-btn:focus-visible { outline: 3px solid rgba(79, 70, 229, .18); outline-offset: 1px; }
    .master-data-message { margin-bottom: 14px; }
    .company-profile-banner { margin-bottom: 16px; padding: 15px; display: flex; align-items: center; gap: 14px; background: linear-gradient(135deg, #faf9ff, #fff); border: 1px solid #e4e0f5; border-radius: 12px; }
    .company-logo-frame { width: 180px; height: 130px; display: grid; place-items: center; flex: 0 0 180px; overflow: hidden; background: #fff; border: 1px solid var(--q-border); border-radius: 14px; box-shadow: 0 7px 18px rgba(15, 23, 42, .08); }
    .company-logo-frame img { width: 100%; height: 100%; padding: 4px; display: block; object-fit: contain; }
    .company-logo-frame i { color: var(--q-primary); font-size: 2.6rem; }
    .company-profile-info { min-width: 0; display: flex; flex: 1; flex-direction: column; gap: 3px; }
    .company-profile-info span, .company-profile-info small { color: var(--q-muted); font-size: .72rem; }
    .company-profile-info strong { overflow: hidden; color: var(--q-ink); font-size: 1rem; text-overflow: ellipsis; white-space: nowrap; }
    .company-edit-only-badge { padding: 6px 9px; color: var(--q-primary); background: var(--q-primary-soft); border-radius: 8px; font-size: .72rem; font-weight: 800; white-space: nowrap; }
    .company-details-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .company-detail-field { min-width: 0; min-height: 76px; padding: 13px 14px; display: flex; flex-direction: column; justify-content: center; gap: 7px; background: #fbfcfd; border: 1px solid var(--q-border); border-radius: 10px; }
    .company-detail-field span { color: var(--q-muted); font-size: .7rem; font-weight: 700; }
    .company-detail-field strong { overflow-wrap: anywhere; color: var(--q-text); font-size: .82rem; font-weight: 750; line-height: 1.65; }
    .company-detail-primary { background: var(--q-primary-faint); border-color: #e2def5; }
    .company-detail-primary strong { color: var(--q-primary-dark); font-size: .92rem; }
    .company-detail-wide { grid-column: 1 / -1; }
    .master-data-empty { min-height: 170px; display: flex; align-items: center; justify-content: center; gap: 9px; color: var(--q-muted); }
    .master-data-empty > i { font-size: 1.3rem; }
    .master-data-table-wrap { max-height: 520px; }
    .master-data-table thead { position: sticky; top: 0; z-index: 2; }
    .master-data-table td { min-width: 110px; }
    .master-data-table td:last-child { min-width: 132px; }
    .master-key-cell { direction: ltr; color: var(--q-muted); font-weight: 700; text-align: right; }
    .master-number { direction: ltr; text-align: right; font-variant-numeric: tabular-nums; }
    .master-actions { justify-content: center; }
    .selected-master-row td { background: var(--q-primary-faint) !important; }
    .master-records-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
    .master-record-card { min-width: 0; overflow: hidden; background: #fff; border: 1px solid var(--q-border); border-radius: 12px; box-shadow: 0 4px 14px rgba(15, 23, 42, .045); transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease; }
    .master-record-card:hover { border-color: #d6d0f4; box-shadow: 0 10px 24px rgba(45, 38, 112, .09); transform: translateY(-2px); }
