@code {
    [Parameter] public object? ToolbarSection { get; set; }
    [Parameter, EditorRequired] public string SectionKey { get; set; } = string.Empty;
    [Parameter] public string? TitleOverride { get; set; }
    [Parameter] public bool EnableSelection { get; set; }
    [Parameter] public bool UseCardLayout { get; set; }
    [Parameter] public EventCallback<MasterDataRowVm> RowSelected { get; set; }
    [Parameter] public EventCallback CreateRequested { get; set; }
    [Parameter] public EventCallback<MasterDataRowVm> EditRequested { get; set; }
    [Parameter] public string? FilterColumn { get; set; }
    [Parameter] public string? FilterValue { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string?>? FixedValues { get; set; }

    private MasterSectionDefinition? definition;
    private PrintReport BuildPrintReport()
    {
        var fields = TableFields.ToArray();
        return new PrintReport { Title = definition!.Title, Landscape = fields.Length > 5,
            Description = $"السجلات المطابقة للبحث: {searchText} | العدد: {filteredRows.Count}",
            Tables = [new PrintTable { Columns = new[] { "الرقم" }.Concat(fields.Select(f => f.Label)).ToArray(),
                Rows = filteredRows.Select(row => new string?[] { row.Id }.Concat(fields.Select(f => FormatDisplay(row, f))).ToArray()).ToList() }] };
    }
    private List<MasterDataRowVm> rows = new();
    private List<MasterDataRowVm> filteredRows = new();
    private Dictionary<string, IReadOnlyList<MasterLookupOptionVm>> lookups = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, string?> editorValues = new(StringComparer.OrdinalIgnoreCase);
    private string editorKeyValue = string.Empty;
    private string? editingId;
    private MasterDataRowVm? deleteRow;
    private string? selectedRowId;
    private string searchText = string.Empty;
    private string sortColumn = string.Empty;
    private bool sortAscending = true;
    private bool isLoading;
    private bool isSaving;
    private bool editorOpen;
    private bool cardViewActive = true;
    private string? editorError;
    private string? message;
    private bool messageIsError;
    private string loadedSignature = string.Empty;

    private IEnumerable<MasterFieldDefinition> TableFields
        => IsPayrollList ? PayrollListFields
            : definition?.Fields.Where(x => x.ShowInTable).Take(7) ?? Enumerable.Empty<MasterFieldDefinition>();

    private bool IsPayrollList => string.Equals(SectionKey, "payroll", StringComparison.OrdinalIgnoreCase) && EditRequested.HasDelegate;
    private static readonly MasterFieldDefinition[] PayrollListFields =
    [
        new("PayrollDate", "تاريخ المسير", MasterFieldKind.Date),
        new("PayrollDesc", "البيان"),
        new("Net", "صافي الراتب", MasterFieldKind.Decimal)
    ];

    private IEnumerable<MasterFieldDefinition> EditableFields
        => definition?.Fields.Where(x => FixedValues is null || !FixedValues.ContainsKey(x.Column))
               ?? Enumerable.Empty<MasterFieldDefinition>();

    private bool IsEmployeesSection => string.Equals(SectionKey, "employees", StringComparison.OrdinalIgnoreCase);
    private IEnumerable<IGrouping<string, MasterFieldDefinition>> EditorGroups
        => EditableFields.GroupBy(item => IsEmployeesSection ? GetEmployeeGroup(item.Column) : IsContactCards ? GetCardGroup(item.Column) : IsCompaniesSection ? GetCompanyGroup(item.Column) : string.Empty);

    private bool UsesInlineEditor => IsEmployeesSection || IsCompaniesSection;
    private bool IsGroupedEditor => UsesInlineEditor || IsContactCards;
    private static string GetCompanyGroup(string column) => column switch
    {
        "Comp" or "CompTel" or "CompAddress" => "البيانات الأساسية والتواصل",
        "VAT" or "CR" => "البيانات النظامية والضريبية",
        "Pic" or "Skin" => "الشعار والمظهر",
        "Header" or "Footer" => "تنسيق التقارير",
        "DBPath" or "ReportsPath" or "AttachPath" or "BackupPath" => "مسارات الملفات والنسخ الاحتياطي",
        _ => "ملاحظات"
    };
    private static string GetCardGroup(string column) => column switch
    {
        "CardNum" or "Title" or "CardName" or "CardType" or "Active" => "البيانات الأساسية",
        "Address1" or "Address2" => "العناوين",
        "Phone1" or "Phone2" or "Fax" or "Email" or "Contact" => "بيانات التواصل",
        "Ref1" or "Ref2" or "VAT" => "المراجع والبيانات الضريبية",
        _ => "ملاحظات"
    };

    private static string GetEmployeeGroup(string column) => column switch
    {
        "EmpCode" or "EmpName" or "JobTitle" or "Department" or "Section" or "EmpStatus" => "البيانات الأساسية والوظيفية",
        "Gender" or "Nationality" or "Religion" or "BirthDate" or "Marital" or "ChildNo" => "البيانات الشخصية والعائلية",
        "Education" or "Qualification" or "Specialisation" or "QDate" or "QGrade" => "التعليم والمؤهلات",
        "CardNo" or "IDType" or "CardDate" or "CardPlace" or "CardExpire" => "بيانات الهوية",
        "PassNo" or "PassDate" or "PassPlace" or "PassExpire" => "بيانات جواز السفر",
        "ContractType" or "ContractDate" or "HiringDate" or "EndDate" or "WorkHours" or "HolidayBalance" => "العقد والعمل والإجازات",
        "BasicSalary" or "HousAllow" or "TransAllow" or "OtherAllow" or "Insurance" or "SalaryStatus" => "الراتب والبدلات",
        "AccountNo" or "BankName" or "BankBranch" => "الحساب البنكي",
        "Mobile" or "Email" or "Address1" => "بيانات التواصل والعنوان",
        _ => "ملاحظات وبيانات إضافية"
    };

    private bool IsCompaniesSection => string.Equals(SectionKey, "companies", StringComparison.OrdinalIgnoreCase);
    private bool CanCreate => !IsCompaniesSection;
    private bool CanDelete => !IsCompaniesSection;
    private string? CompanyLogoSource => rows.FirstOrDefault()?.Values.GetValueOrDefault("Pic");
    private string CompanyDisplayName => rows.Count == 0 ? "بيانات المنشأة" : GetColumnDisplay(rows[0], "Comp", "بيانات المنشأة");
    private IEnumerable<MasterFieldDefinition> CompanyDisplayFields
        => definition?.Fields.Where(x => x.Kind != MasterFieldKind.Image) ?? Enumerable.Empty<MasterFieldDefinition>();
    private bool IsContactCards => string.Equals(SectionKey, "cards", StringComparison.OrdinalIgnoreCase);
    private string CardTitleColumn => IsContactCards ? "CardName" : "EmpName";
    private string CardSubtitleColumn => IsContactCards ? "CardType" : "JobTitle";
    private IReadOnlyList<CardDetailDefinition> CardDetails => IsContactCards
        ?
        [
            new("CardNum", "رقم الجهة", "bi-upc-scan"),
            new("Phone1", "الهاتف", "bi-telephone"),
            new("Email", "البريد الإلكتروني", "bi-envelope"),
            new("Contact", "مسؤول الاتصال", "bi-person-lines-fill"),
            new("VAT", "الرقم الضريبي", "bi-receipt", Wide: true)
        ]
        :
        [
            new("EmpCode", "كود الموظف", "bi-upc-scan"),
            new("Department", "الإدارة", "bi-building"),
            new("EmpStatus", "الحالة", "bi-person-check"),
            new("BasicSalary", "الراتب الأساسي", "bi-cash-stack", Numeric: true),
            new("Mobile", "الجوال", "bi-phone", Wide: true)
        ];

    protected override async Task OnParametersSetAsync()
    {
        var signature = $"{SectionKey}|{FilterColumn}|{FilterValue}";
        if (signature == loadedSignature)
        {
            return;
        }
        loadedSignature = signature;
        definition = MasterDataService.GetSection(SectionKey);
        sortColumn = definition.KeyColumn;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (definition is null) return;
        isLoading = true;
        message = null;
        try
        {
            rows = (IsPayrollList
                ? await MasterDataService.GetPreviousPayrollsAsync()
                : await MasterDataService.GetRowsAsync(SectionKey, FilterColumn, FilterValue)).ToList();
            lookups = await MasterDataService.GetLookupsAsync(SectionKey);
            ApplySearch();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex);
            message = "تعذر تحميل السجلات؛ حاول مرة أخرى أو راجع مسؤول النظام.";
            messageIsError = true;
            rows.Clear();
            filteredRows.Clear();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreate()
    {
        if (CreateRequested.HasDelegate)
        {
            await CreateRequested.InvokeAsync();
            return;
        }
        editorError = null;
        editingId = null;
        editorKeyValue = string.Empty;
        editorValues = definition?.Fields.ToDictionary(
            x => x.Column,
            x => x.Kind == MasterFieldKind.Boolean ? "false" : null,
            StringComparer.OrdinalIgnoreCase) ?? new(StringComparer.OrdinalIgnoreCase);
        if (string.Equals(SectionKey, "periods", StringComparison.OrdinalIgnoreCase))
        {
            foreach (var sequenceField in new[] { "GLID", "RCID", "PMID", "SalesID", "PurchID", "PayrollID" })
            {
                editorValues[sequenceField] = "1";
            }
        }
        ApplyFixedValues();
        editorOpen = true;
        message = null;
    }

    private async Task OpenEdit(MasterDataRowVm row)
    {
        if (EditRequested.HasDelegate)
        {
            await EditRequested.InvokeAsync(row);
            return;
        }
        editorError = null;
        editingId = row.Id;
        editorKeyValue = row.Id;
        editorValues = new Dictionary<string, string?>(row.Values, StringComparer.OrdinalIgnoreCase);
        ApplyFixedValues();
        editorOpen = true;
        message = null;
    }

    private void CloseEditor() => editorOpen = false;
    private void OpenDelete(MasterDataRowVm row) => deleteRow = row;
    private void CloseDelete() => deleteRow = null;

    private async Task SaveAsync()
    {
        if (definition is null || isSaving) return;
        editorError = null;
        isSaving = true;
        if (!definition.KeyIsIdentity && editingId is null)
        {
            editorValues[definition.KeyColumn] = editorKeyValue;
        }
        ApplyFixedValues();
        var result = await MasterDataService.SaveAsync(SectionKey, editingId, editorValues);
        isSaving = false;
        message = result.Message;
        messageIsError = !result.Success;
        if (!result.Success)
        {
            editorError = result.Message;
            return;
        }
        editorOpen = false;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (deleteRow is null) return;
        isSaving = true;
        var result = await MasterDataService.DeleteAsync(SectionKey, deleteRow.Id);
        isSaving = false;
        message = result.Message;
        messageIsError = !result.Success;
        if (result.Success)
        {
            deleteRow = null;
            await LoadAsync();
        }
    }

    private async Task SelectRowAsync(MasterDataRowVm row)
    {
        selectedRowId = row.Id;
        if (RowSelected.HasDelegate)
        {
            await RowSelected.InvokeAsync(row);
        }
    }

    private void ApplyFixedValues()
    {
        if (FixedValues is null) return;
        foreach (var pair in FixedValues)
        {
            editorValues[pair.Key] = pair.Value;
        }
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        ApplySearch();
    }

    private void ApplySearch()
    {
        var term = searchText.Trim();
        filteredRows = string.IsNullOrWhiteSpace(term)
            ? rows.ToList()
            : rows.Where(row => row.Id.Contains(term, StringComparison.OrdinalIgnoreCase)
                                || (IsPayrollList ? TableFields : definition!.Fields).Any(field => FormatDisplay(row, field).Contains(term, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        ApplySort();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column) sortAscending = !sortAscending;
        else { sortColumn = column; sortAscending = true; }
        ApplySort();
    }

    private void SetCardView(bool useCards) => cardViewActive = useCards;

    private void ApplySort()
    {
        if (definition is null) return;
        var field = (IsPayrollList ? TableFields : definition.Fields).FirstOrDefault(x => x.Column.Equals(sortColumn, StringComparison.OrdinalIgnoreCase));
        Func<MasterDataRowVm, object> keySelector = row => GetSortValue(row, field);
        filteredRows = sortAscending
            ? filteredRows.OrderBy(keySelector).ToList()
            : filteredRows.OrderByDescending(keySelector).ToList();
    }

    private object GetSortValue(MasterDataRowVm row, MasterFieldDefinition? field)
    {
        if (field is null) return long.TryParse(row.Id, out var id) ? id : row.Id;
        row.Values.TryGetValue(field.Column, out var value);
        return field.Kind switch
        {
            MasterFieldKind.Integer or MasterFieldKind.Decimal or MasterFieldKind.Lookup
                => decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var number) ? number : 0m,
            MasterFieldKind.Date => DateTime.TryParse(value, out var date) ? date : DateTime.MinValue,
            MasterFieldKind.Boolean => string.Equals(value, "true", StringComparison.OrdinalIgnoreCase),
            _ => value ?? string.Empty
        };
    }

    private string FormatDisplay(MasterDataRowVm row, MasterFieldDefinition field)
    {
        row.Values.TryGetValue(field.Column, out var value);
        if (string.IsNullOrWhiteSpace(value)) return "-";
        if (field.Kind == MasterFieldKind.Password) return "••••••";
        if (field.Kind == MasterFieldKind.Image) return "شعار المنشأة";
        if (field.Kind == MasterFieldKind.Lookup)
        {
            return GetLookupOptions(field.Column).FirstOrDefault(x => x.Value == value)?.Label ?? value;
        }
        if (field.Kind == MasterFieldKind.Decimal
            && decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var decimalValue))
        {
            return decimalValue.ToString("N2");
        }
        if (field.Kind == MasterFieldKind.Date && DateTime.TryParse(value, out var dateValue))
        {
            return dateValue.ToString("yyyy/MM/dd");
        }
        return value;
    }

    private string GetColumnDisplay(MasterDataRowVm row, string column, string emptyValue = "-")
    {
        if (definition is null) return emptyValue;
        var field = definition.Fields.FirstOrDefault(x => x.Column.Equals(column, StringComparison.OrdinalIgnoreCase));
        if (field is null) return emptyValue;
        var value = FormatDisplay(row, field);
        return value == "-" ? emptyValue : value;
    }

    private static string GetCompanyFieldClass(MasterFieldDefinition field)
    {
        if (field.Column.Equals("Comp", StringComparison.OrdinalIgnoreCase)) return "company-detail-primary";
        return field.Kind == MasterFieldKind.Multiline
               || field.Column is "Header" or "Footer" or "DBPath" or "ReportsPath" or "AttachPath" or "BackupPath"
            ? "company-detail-wide"
            : string.Empty;
    }

    private string GetInitials(MasterDataRowVm row)
    {
        var name = GetColumnDisplay(row, CardTitleColumn, IsContactCards ? "ج" : "م");
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(x => x[0]));
    }

    private string GetCardFooterText(MasterDataRowVm row)
        => IsContactCards
            ? (IsCardRecordActive(row) ? "جهة نشطة" : "جهة غير نشطة")
            : GetColumnDisplay(row, "SalaryStatus", "بيانات الموظف");

    private bool IsCardRecordActive(MasterDataRowVm row)
    {
        if (!IsContactCards) return true;
        return row.Values.TryGetValue("Active", out var value)
               && string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
    }

    private IReadOnlyList<MasterLookupOptionVm> GetLookupOptions(string column)
        => lookups.TryGetValue(column, out var options) ? options : Array.Empty<MasterLookupOptionVm>();

    private string GetEditorValue(string column)
        => editorValues.TryGetValue(column, out var value) ? value ?? string.Empty : string.Empty;

    private bool GetEditorBool(string column)
        => bool.TryParse(GetEditorValue(column), out var value) && value;

    private void SetEditorValue(string column, ChangeEventArgs e) => editorValues[column] = e.Value?.ToString();
    private void SetEditorBool(string column, ChangeEventArgs e) => editorValues[column] = (e.Value as bool? ?? false).ToString().ToLowerInvariant();

    private async Task OnImageSelectedAsync(string column, InputFileChangeEventArgs e)
    {
        const long maxImageSize = 5 * 1024 * 1024;
        var file = e.File;
        var allowedTypes = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "image/png", "image/jpeg", "image/gif", "image/bmp", "image/webp"
        };

        if (!allowedTypes.Contains(file.ContentType))
        {
            editorError = "صيغة الشعار غير مدعومة. اختر صورة PNG أو JPG أو GIF أو BMP أو WEBP.";
            return;
        }
        if (file.Size > maxImageSize)
        {
            editorError = "حجم الشعار أكبر من 5 ميجابايت.";
            return;
        }

        try
        {
            await using var input = file.OpenReadStream(maxImageSize);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer);
            editorValues[column] = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
            editorError = null;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex); editorError = "تعذر قراءة ملف الشعار؛ حاول مرة أخرى أو راجع مسؤول النظام.";
        }
    }
    private static bool IsTrue(MasterDataRowVm row, string column) => row.Values.TryGetValue(column, out var value) && string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
    private string GetSortIcon(string column) => sortColumn == column ? (sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down") : "bi bi-arrow-down-up";

    private sealed record CardDetailDefinition(string Column, string Label, string Icon, bool Numeric = false, bool Wide = false);
}




