@using BlazorApp1.Services
@implements IAsyncDisposable
@inject JournalAttachmentService Attachments
@inject IJSRuntime JS
@inject IUserAccessService Access

@if (Access.Has("Archive"))
{
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Show" disabled="@(EntryId <= 0)"><i class="bi bi-paperclip"></i> مرفقات على هذا الجهاز</button>
    @if (visible)
    {
        <div class="attachment-overlay" role="dialog" aria-modal="true" aria-label="مرفقات القيد">
            <section class="card attachment-panel" dir="rtl">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>مرفقات القيد #@EntryId</strong>
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Close">إغلاق</button>
                </div>
                <div class="card-body">
                    @if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
                    <div @ref="host"></div>
                </div>
            </section>
        </div>
    }
}
<style>
    .attachment-overlay { position: fixed; inset: 0; background: #0006; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 20px; }
    .attachment-panel { width: min(760px, 100%); max-height: 85vh; overflow: auto; }
    .local-attachment-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
    .local-attachment-upload { position: relative; overflow: hidden; }
    .local-attachment-upload input { position: absolute; inset: 0; opacity: 0; width: 100%; cursor: pointer; }
</style>
@code {
    [Parameter] public int EntryId { get; set; }
    private bool visible, mountPending;
    private int authorizedEntryId;
    private string? error;
    private ElementReference host;
    private JournalAttachmentService.LocalContext? context;
    private IJSObjectReference? module;
    private DotNetObjectReference<JournalAttachments>? callback;

    private async Task Show()
    {
        error = null;
        try
        {
            authorizedEntryId = EntryId;
            context = await Attachments.GetLocalContextAsync(authorizedEntryId);
            mountPending = true;
        }
        catch (Exception ex) { error = ex is InvalidOperationException ? ex.Message : "لا يمكن الوصول إلى مرفقات هذا القيد."; }
        visible = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mountPending || !visible || context is null) return;
        mountPending = false;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/local-journal-attachments.js");
            callback ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("mount", host, context, callback);
        }
        catch (JSException) { error = "تعذر تهيئة المرفقات المحلية. حدّث الصفحة وحاول مجددًا."; StateHasChanged(); }
    }
    [JSInvokable]
    public async Task<JournalAttachmentService.LocalContext> AuthorizeLocalOperation()
    {
        if (!visible || EntryId != authorizedEntryId) throw new InvalidOperationException("أعد فتح مرفقات القيد.");
        return await Attachments.GetLocalContextAsync(authorizedEntryId);
    }
    private async Task Close()
    {
        if (module is not null) await module.InvokeVoidAsync("unmount", host);
        visible = false;
    }
    public async ValueTask DisposeAsync()
    {
        visible = false;
        try { if (module is not null) { await module.InvokeVoidAsync("unmount", host); await module.DisposeAsync(); } }
        catch (JSDisconnectedException) { }
        callback?.Dispose();
    }
}
