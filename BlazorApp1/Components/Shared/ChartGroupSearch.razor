@using BlazorApp1.Services

<div class="mb-3">
    <label for="@InputId" class="form-label">@Label</label>
    
    <button id="@InputId" @ref="trigger" type="button" class="btn btn-outline-primary w-100 d-flex justify-content-between align-items-center" disabled="@Disabled" aria-haspopup="dialog" aria-expanded="@isOpen" @onclick="Open">
        <span class="text-end">@SelectedLabel</span><i class="bi bi-search" aria-hidden="true"></i>
    </button>
</div>
@if (isOpen)
{
    <div class="group-picker-overlay" @onkeydown="OnKeyDown">
        <section class="group-picker" role="dialog" aria-modal="true" aria-labelledby="@(InputId + "-title")" dir="rtl">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <h5 id="@(InputId + "-title")" class="mb-0">اختيار @Label</h5>
                <button type="button" class="btn btn-sm btn-light" aria-label="إغلاق قائمة التصنيفات" @onclick="Close">×</button>
            </div>
            <label for="@(InputId + "-input")" class="form-label">البحث بالرقم أو الاسم</label>
            <input id="@(InputId + "-input")" @ref="searchInput" type="search" class="form-control" placeholder="ابحث بالرقم أو الاسم" @bind="search" @bind:event="oninput" disabled="@Disabled" />
            <div class="parent-results group-picker-results" aria-label="نتائج البحث: @Label">
                @foreach (var option in Matches)
                {
                    <button type="button" class="parent-result @(Value == option.Id ? "selected" : "")" aria-pressed="@(Value == option.Id)" disabled="@Disabled" @onclick="() => Choose(checked((int)option.Id))"><strong>@option.Id — @option.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(option.Detail)) { <small class="d-block text-muted mt-1">@option.Detail</small> }
                    </button>
                }
                @if (!Matches.Any()) { <p class="text-muted p-2 mb-0">لا توجد تصنيفات مطابقة.</p> }
            </div>
            <div class="d-flex justify-content-between gap-2 mt-3">
                @if (AllowClear) { <button type="button" class="btn btn-outline-secondary" disabled="@Disabled" @onclick="() => Choose(null)">بدون تصنيف</button> }
                <button type="button" class="btn btn-light" @onclick="Close">إلغاء</button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string InputId { get; set; } = "";
    [Parameter] public IReadOnlyList<ChartParentOptionVm> Options { get; set; } = Array.Empty<ChartParentOptionVm>();
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    private string search = "";
    private bool isOpen;
    private bool focusSearch;
    private ElementReference searchInput;
    private ElementReference trigger;
    private void Open()
    {
        if (Disabled) return;
        search = "";
        isOpen = true;
        focusSearch = true;
    }
    private async Task Close()
    {
        isOpen = false;
        await trigger.FocusAsync();
    }
    private async Task Choose(int? id)
    {
        if (Disabled) return;
        await ValueChanged.InvokeAsync(id);
        await Close();
    }
    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") await Close();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusSearch && isOpen)
        {
            focusSearch = false;
            await searchInput.FocusAsync();
        }
    }
    private string SelectedLabel => Value is null ? (AllowClear ? "بدون تصنيف — اضغط للاختيار" : $"اختر {Label}") : Options.FirstOrDefault(x => x.Id == Value) is { } option
        ? $"{option.Id} — {option.Name}" : $"التصنيف {Value} غير متاح؛ أزل الاختيار أو اختر تصنيفاً آخر.";
    private IEnumerable<ChartParentOptionVm> Matches => Options.Where(x => string.IsNullOrWhiteSpace(search) ||
        x.Id.ToString().Contains(search.Trim()) || x.Name.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || (x.Detail?.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));
}
