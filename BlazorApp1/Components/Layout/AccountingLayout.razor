@inherits LayoutComponentBase
@using BlazorApp1.Services
@inject ISessionService SessionService
@inject IUserAccessService Access
@inject IProAccDbContextAccessor DbContextAccessor
@inject NavigationManager NavigationManager

<div class="accounting-layout" dir="rtl">
    <!-- القائمة الجانبية -->
    <div class="sidebar @(sidebarCollapsed ? "collapsed" : "") @(mobileMenuOpen ? "mobile-open" : "")">
        <div class="sidebar-header">
            <div class="logo-section">
                @if (!sidebarCollapsed)
                {
                    <img src="/images/proacc-logo.png" class="logo-icon-image" alt="شعار نظام ProACC المحاسبي" />
                    <div class="logo-text-wrap">
                        <h4>ProACC</h4>
                        <span class="logo-subtitle">النظام المحاسبي</span>
                    </div>
                }
                else
                {
                    <img src="/images/proacc-logo.png" class="logo-icon-image logo-icon-image-small" alt="شعار نظام ProACC المحاسبي" />
                }
            </div>
            <button class="mobile-close-button" type="button" @onclick="ToggleMobileMenu" aria-label="إغلاق القائمة">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="user-profile @(sidebarCollapsed ? "collapsed" : "")">
            <div class="profile-avatar">
                <i class="bi bi-person-circle"></i>
            </div>
            @if (!sidebarCollapsed)
            {
                <div class="profile-info">
                    <span class="profile-name">@SessionService.CurrentUsername</span>
                    <span class="profile-role">@GetSessionContextText()</span>
                </div>
            }
        </div>

        <nav class="sidebar-nav">
            @if (Access.Has("Main"))
            {
                <div class="nav-section @(sidebarCollapsed ? "d-none" : "")">نظرة عامة</div>
            }
            @if (SectionAccess.CanRoute("/dashboard", Access.Has))
            {
<NavLink class="nav-item" href="/dashboard" Match="NavLinkMatch.All" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-speedometer2"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">الرئيسية</span>
            </NavLink>
            }

            @if (new[] { "GL", "RC", "PM", "INV", "Cards" }.Any(Access.Has))
            {
                <div class="nav-section @(sidebarCollapsed ? "d-none" : "")">المحاسبة</div>
            }
            @if (SectionAccess.CanRoute("/accounting/journal-entries", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/journal-entries" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-journal-text"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">قيود اليومية</span>
            </NavLink>
            }

            @if (SectionAccess.CanRoute("/accounting/opening-balances", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/opening-balances" @onclick="CloseMobileMenu">
                <div class="nav-icon"><i class="bi bi-journal-arrow-up"></i></div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">قيود إفتتاحية</span>
            </NavLink>
            }

            @if (SectionAccess.CanRoute("/accounting/receipts", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/receipts" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">سندات القبض</span>
            </NavLink>
            }

            @if (SectionAccess.CanRoute("/accounting/payments", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/payments" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">سندات الصرف</span>
            </NavLink>
            }

            @if (SectionAccess.CanRoute("/accounting/invoices", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/invoices" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">فواتير المبيعات</span>
            </NavLink>
            }

            @if (SectionAccess.CanRoute("/accounting/purchase-invoices", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/purchase-invoices" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-file-earmark-arrow-down"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">فواتير المشتريات</span>
            </NavLink>
            }

            @if (SectionAccess.CanRoute("/accounting/cards", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/cards" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">جهات التعامل</span>
            </NavLink>
            }

            @if (new[] { "EmpCard", "Payroll", "Holidays" }.Any(Access.Has) || SectionAccess.CanRoute("/accounting/reports/employees", Access.Has))
            {
                <div class="nav-section @(sidebarCollapsed ? "d-none" : "")">الموارد البشرية</div>
            }
            @if (Access.Has("EmpCard") || Access.Has("Payroll") || Access.Has("Holidays") || SectionAccess.CanRoute("/accounting/reports/employees", Access.Has))
            {
            <div class="nav-group @(IsHrSectionActive() ? "active" : "")">
                <button type="button" aria-expanded="@hrMenuExpanded" class="nav-item nav-group-parent" @onclick="ToggleHrMenu">
                    <div class="nav-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">الموارد البشرية</span>
                    @if (!sidebarCollapsed)
                    {
                        <i class="bi @(hrMenuExpanded ? "bi-chevron-down" : "bi-chevron-left") nav-group-arrow"></i>
                    }
                </button>

                @if (!sidebarCollapsed && hrMenuExpanded)
                {
                    <div class="nav-submenu">
                        @if (SectionAccess.CanRoute("/accounting/hr/employees", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/hr/employees" @onclick="CloseMobileMenu">
                            <i class="bi bi-person-badge"></i>
                            <span>تعريف الموظفين</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/hr/payroll", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/hr/payroll" @onclick="CloseMobileMenu">
                            <i class="bi bi-cash-stack"></i>
                            <span>الرواتب</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/hr/holidays", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/hr/holidays" @onclick="CloseMobileMenu">
                            <i class="bi bi-calendar2-check"></i>
                            <span>الإجازات</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/reports/employees", Access.Has))
                        {
                            <NavLink class="nav-sub-item" href="/accounting/reports/employees" @onclick="CloseMobileMenu">
                                <i class="bi bi-person-lines-fill"></i><span>تقارير الموظفين</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>

            }
            @if (new[] { "Reports", "Data", "Setting", "Users", "Designer" }.Any(Access.Has))
            {
                <div class="nav-section @(sidebarCollapsed ? "d-none" : "")">التقارير والإعدادات</div>
            }
            @if (Access.Has("Reports"))
            {
            <div class="nav-group @(IsReportsSectionActive() ? "active" : "")">
                <button type="button" aria-expanded="@reportsMenuExpanded" class="nav-item nav-group-parent" @onclick="ToggleReportsMenu">
                    <div class="nav-icon">
                        <i class="bi bi-bar-chart-line"></i>
                    </div>
                    <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">التقارير المالية</span>
                    @if (!sidebarCollapsed)
                    {
                        <i class="bi @(reportsMenuExpanded ? "bi-chevron-down" : "bi-chevron-left") nav-group-arrow"></i>
                    }
                </button>

                @if (!sidebarCollapsed && reportsMenuExpanded)
                {
                    <div class="nav-submenu">
                        @if (SectionAccess.CanRoute("/accounting/reports/general-journal", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/reports/general-journal" @onclick="CloseMobileMenu">
                            <i class="bi bi-journal-text"></i>
                            <span>اليومية العامة</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/reports/trial-balance", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/reports/trial-balance" @onclick="CloseMobileMenu">
                            <i class="bi bi-table"></i>
                            <span>ميزان المراجعة</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/reports/account-statement", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/reports/account-statement" @onclick="CloseMobileMenu">
                            <i class="bi bi-file-earmark-spreadsheet"></i>
                            <span>كشف حساب</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/reports/financial-position", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/reports/financial-position" @onclick="CloseMobileMenu">
                            <i class="bi bi-bank"></i>
                            <span>المركز المالي</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/reports/income-statement", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/reports/income-statement" @onclick="CloseMobileMenu">
                            <i class="bi bi-graph-up-arrow"></i>
                            <span>قائمة الدخل</span>
                        </NavLink>
            }
                        @if (SectionAccess.CanRoute("/accounting/reports/cost-centers", Access.Has))
            {
<NavLink class="nav-sub-item" href="/accounting/reports/cost-centers" @onclick="CloseMobileMenu">
                            <i class="bi bi-diagram-3"></i>
                            <span>مراكز التكلفة</span>
                        </NavLink>
            }
                    </div>
                }
            </div>

            }
            @if (SectionAccess.CanRoute("/accounting/chart-of-accounts", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/chart-of-accounts" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-diagram-3"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">دليل الحسابات</span>
            </NavLink>
            }

            @if (SectionAccess.CanRoute("/accounting/settings", Access.Has))
            {
<NavLink class="nav-item" href="/accounting/settings" @onclick="CloseMobileMenu">
                <div class="nav-icon">
                    <i class="bi bi-gear-fill"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">الإعدادات</span>
            </NavLink>
            }

            @if (Access.Has("Designer"))
            {
                <NavLink class="nav-item" href="/accounting/report-designer" @onclick="CloseMobileMenu" title="مصمم التقارير">
                    <div class="nav-icon"><i class="bi bi-palette"></i></div>
                    <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">مصمم التقارير</span>
                </NavLink>
            }

            <button class="nav-item" type="button" @onclick="OpenAboutModal" title="حول النظام" aria-label="عرض معلومات حول النظام">
                <div class="nav-icon"><i class="bi bi-info-circle-fill"></i></div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">حول النظام</span>
            </button>

            <button type="button" aria-label="طي أو توسيع القائمة الجانبية" class="nav-item toggle-sidebar-item" @onclick="ToggleSidebar">
                <div class="nav-icon">
                    <i class="bi @(sidebarCollapsed ? "bi-layout-sidebar-inset" : "bi-layout-sidebar")"></i>
                </div>
                <span class="nav-text @(sidebarCollapsed ? "d-none" : "")">@(sidebarCollapsed ? "توسيع القائمة" : "طي القائمة")</span>
            </button>

        </nav>
    </div>

    <!-- المحتوى الرئيسي -->
    <div class="main-content">
        <div class="top-bar">
            <div class="page-heading">
                <button class="mobile-menu-button" type="button" @onclick="ToggleMobileMenu" aria-label="فتح القائمة">
                    <i class="bi bi-list"></i>
                </button>
                <div class="breadcrumb">
                    <i class="bi bi-house-door-fill breadcrumb-icon"></i>
                    <span>@GetCurrentPageTitle()</span>
                </div>
            </div>
            <div class="top-bar-actions">
                <button class="topbar-logout topbar-action-card" type="button" @onclick="HandleLogout" title="تسجيل الخروج" aria-label="تسجيل الخروج">
                    <i class="bi bi-box-arrow-left"></i>
                </button>
                <div class="period-display topbar-action-card" title="الفترة المالية الحالية">
                    <i class="bi bi-calendar2-range"></i>
                    <span class="period-display-text">
                        <span>الفترة المالية الحالية</span>
                        <strong>@GetCurrentPeriodDisplay()</strong>
                    </span>
                </div>
                <div class="company-display topbar-action-card" title="@SessionService.SelectedCompanyName">
                    <i class="bi bi-buildings"></i>
                    <strong>@(string.IsNullOrWhiteSpace(SessionService.SelectedCompanyName) ? "المنشأة" : SessionService.SelectedCompanyName)</strong>
                </div>
                <div class="topbar-user topbar-action-card">
                    <div class="topbar-user-avatar">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div class="topbar-user-info">
                        <span class="topbar-user-name">@SessionService.CurrentUsername</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-area">
            @Body
        </div>
    </div>
</div>

