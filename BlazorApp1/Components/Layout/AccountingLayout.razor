                        <div class="social-section">
                            <span>تابعنا على</span>
                            <div class="social-links" aria-label="منصات التواصل الاجتماعي">
                                <span class="social-link facebook" title="فيسبوك"><i class="bi bi-facebook"></i><span>فيسبوك</span></span>
                                <span class="social-link instagram" title="إنستغرام"><i class="bi bi-instagram"></i><span>إنستغرام</span></span>
