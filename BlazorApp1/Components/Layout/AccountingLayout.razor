@code {
    private bool sidebarCollapsed = false;
    // Authorization checks can recreate the layout when navigating; keep user choices in the session.
    private bool reportsMenuExpanded
    {
        get => SessionService.SidebarMenus.ReportsExpanded;
        set => SessionService.SidebarMenus.ReportsExpanded = value;
    }
    private bool hrMenuExpanded
    {
        get => SessionService.SidebarMenus.HrExpanded;
        set => SessionService.SidebarMenus.HrExpanded = value;
    }
    private bool mobileMenuOpen;
    private bool aboutModalOpen;

    private void OpenAboutModal()
    {
        CloseMobileMenu();
        aboutModalOpen = true;
    }

    private void CloseAboutModal() => aboutModalOpen = false;

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }

    private void ToggleMobileMenu()
    {
        mobileMenuOpen = !mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        mobileMenuOpen = false;
    }

    private void ToggleReportsMenu()
    {
        if (sidebarCollapsed)
        {
            return;
        }

        reportsMenuExpanded = !reportsMenuExpanded;
    }

    private void ToggleHrMenu()
    {
        if (sidebarCollapsed)
        {
            return;
        }

        hrMenuExpanded = !hrMenuExpanded;
    }

    private async Task HandleLogout()
    {
        await SessionService.LogoutAsync();
        DbContextAccessor.Reset();
        NavigationManager.NavigateTo("/login");
    }

    private string GetCurrentPageTitle()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return path switch
        {
            "" or "dashboard" => "الرئيسية",
            "accounting/journal-entries" => "قيود اليومية",
            "accounting/receipts" => "سندات القبض",
            "accounting/payments" => "سندات الصرف",
            "accounting/invoices" => "فواتير المبيعات",
            "accounting/purchase-invoices" => "فواتير المشتريات",
            "accounting/cards" => "جهات التعامل",
            "accounting/hr/employees" => "تعريف الموظفين",
            "accounting/hr/payroll" => "الرواتب",
            "accounting/hr/holidays" => "الإجازات",
            "accounting/reports" => "التقارير المالية",
            "accounting/reports/employees" => "تقارير الموظفين",
            "accounting/reports/general-journal" => "اليومية العامة",
            "accounting/reports/trial-balance" => "ميزان المراجعة",
            "accounting/reports/account-statement" => "كشف حساب",
            "accounting/reports/financial-position" => "المركز المالي",
            "accounting/reports/income-statement" => "قائمة الدخل",
            "accounting/reports/cost-centers" => "مراكز التكلفة",
            "accounting/opening-balances" => "الأرصدة الافتتاحية",
            "accounting/settings" => "الإعدادات",
            "accounting/report-designer" or "accounting/settings/report-designer" => "مصمم التقارير",
            "accounting/chart-of-accounts" => "دليل الحسابات",
            _ => "النظام المحاسبي"
        };
    }

    private bool IsReportsSectionActive()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return path.StartsWith("accounting/reports", StringComparison.OrdinalIgnoreCase)
            && !IsHrSectionActive();
    }

    private bool IsHrSectionActive()
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return path.StartsWith("accounting/hr", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("accounting/reports/employees", StringComparison.OrdinalIgnoreCase);
    }

    private string GetSessionContextText()
    {
        var company = string.IsNullOrWhiteSpace(SessionService.SelectedCompanyName)
            ? "النظام المحاسبي"
            : SessionService.SelectedCompanyName;

        var period = string.IsNullOrWhiteSpace(SessionService.SelectedPeriodName)
            ? "بدون فترة محددة"
            : SessionService.SelectedPeriodName;

        return $"{company} • {period}";
    }

    private string GetCurrentPeriodDisplay()
        => !string.IsNullOrWhiteSpace(SessionService.SelectedPeriodName)
            ? SessionService.SelectedPeriodName
            : SessionService.SelectedPeriodId?.ToString() ?? "بدون فترة";

}

