@code {
    private const string InvoiceDataTab = "invoice";
    private const string AccountingDirectionTab = "accounting";
    private const decimal DefaultVatRate = 15m;

    [Parameter] public int? GLID { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "sourceId")] public int? FixedSourceId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private GlEntity glHeader = new() { GLDate = DateTime.Today };
    private List<TransEntity> transactions = new();
    private List<TransEntity> invoiceAccountingTransactions = new();
    private string activeSubrecordTab = string.Empty;
    private List<AccEntity> accounts = new();
    private List<SourceEntity> sources = new();
    private List<CardEntity> cards = new();
    private List<MethodEntity> methods = new();
    private List<BankEntity> banks = new();
    private List<Center1Entity> centers1 = new();
    private List<Center2Entity> centers2 = new();
    private List<Center3Entity> centers3 = new();
    private List<VatEntity> vatRates = new();
    private List<JournalEntryVm> previousEntries = new();
    private SettingsDataVm settingsData = new();

    private bool isLoading = false;
    private bool isImporting;
    private async Task ImportCsv(InputFileChangeEventArgs args)
    {
        if (isLoading || isImporting || IsInvoiceSource) return;
        isImporting = true;
        errorMessage = statusMessage = null;
        try
        {
            await Access.RequireAsync(SectionAccess.Source(glHeader.SourceID));
            if (glHeader.GLID > 0) await Access.RequireEntryAsync(glHeader.GLID);
            if (!string.Equals(System.IO.Path.GetExtension(args.File.Name), ".csv", StringComparison.OrdinalIgnoreCase))
                throw new FormatException("اختر ملف CSV.");
            await using var stream = args.File.OpenReadStream(JournalCsvImporter.MaxFileSize);
            using var reader = new System.IO.StreamReader(stream, new System.Text.UTF8Encoding(false, true), true);
            var imported = JournalCsvImporter.Parse(await reader.ReadToEndAsync(), accounts, glHeader.GLID);
            transactions.RemoveAll(t => !t.ACCID.HasValue && (t.DR ?? 0) == 0 && (t.CR ?? 0) == 0
                && string.IsNullOrWhiteSpace(t.TransDesc) && string.IsNullOrWhiteSpace(t.DocRef)
                && !t.DocDate.HasValue && !t.Center3.HasValue);
            transactions.AddRange(imported);
            tableColumnsInitialized = false;
            statusMessage = $"تم استيراد {imported.Count} سطر. راجع السطور وتوازن القيد ثم اضغط حفظ.";
        }
        catch (FormatException ex) { errorMessage = ex.Message; }
        catch (UnauthorizedAccessException ex) { errorMessage = ex.Message; }
        catch (System.Text.DecoderFallbackException) { errorMessage = "احفظ الملف بترميز UTF-8 ثم أعد المحاولة."; }
        catch (System.IO.IOException) { errorMessage = "تعذر قراءة الملف؛ تحقق من حجمه (5 ميغابايت كحد أقصى) وأعد المحاولة."; }
        finally { isImporting = false; }
    }
    private string? errorMessage;
    private string? statusMessage;
    private int? selectedFinancialYear;
    private bool showAccountPicker;
    private int accountPickerTransactionIndex = -1;
    private bool accountPickerTargetsHeader;
    private bool accountPickerTargetsAccountingDirection;
    private string accountSearchText = string.Empty;
    private bool showLookupPicker;
    private string activeLookupKind = string.Empty;
    private string lookupSearchText = string.Empty;
    private int lookupTransactionIndex = -1;
    private bool lookupTargetsAccountingDirection;
    private bool showPreviousEntryPicker;
    private bool showHeaderDataCopyConfirmation;
    private bool tableColumnsInitialized;
    private bool isLoadingPreviousEntries;
    private string previousEntrySearchText = string.Empty;
    private decimal invoiceAmountTotal => transactions.Sum(t => t.Amount ?? 0m);
    private decimal invoiceTaxTotal => transactions.Sum(t => t.TaxAmount ?? 0m);
    private decimal invoiceGrandTotal => transactions.Sum(t => t.TotalAmount ?? 0m);
    private List<TransEntity> AccountingDirectionTransactions => invoiceAccountingTransactions;
    private int ActiveTransactionCount => IsInvoiceSource && !IsInvoiceDataTab ? AccountingDirectionTransactions.Count : transactions.Count;
    private decimal totalDebit => (IsInvoiceSource ? AccountingDirectionTransactions : transactions).Sum(t => t.DR ?? 0);
    private decimal totalCredit => (IsInvoiceSource ? AccountingDirectionTransactions : transactions).Sum(t => t.CR ?? 0);
    private decimal BalanceDifference => Math.Abs(totalDebit - totalCredit);
    private bool IsBalanced => BalanceDifference <= 0.01m;
    private bool IsOpeningSource => FixedSourceId == 4;
    private bool IsDocumentSource => FixedSourceId is 2 or 3 or 5 or 6;
    private bool IsInvoiceSource => FixedSourceId is 5 or 6;
    private bool IsInvoiceDataTab => IsInvoiceSource && activeSubrecordTab == InvoiceDataTab;
    private string SubrecordSectionTitle => IsInvoiceDataTab
        ? "بيانات الفاتورة"
        : IsInvoiceSource ? "التوجيه المحاسبي" : "تفاصيل القيد";
    private string ActiveLinesTableId => IsInvoiceDataTab ? "invoice-lines-table" : "journal-lines-table";
    private string DocumentName => FixedSourceId switch
    {
        4 => "قيد افتتاحي",
        2 => "سند قبض",
        3 => "سند صرف",
        5 => "فاتورة مبيعات",
        6 => "فاتورة مشتريات",
        _ => "قيد يومية"
    };
    private string EditorTitle => $"{(GLID.HasValue ? "تعديل" : "إضافة")} {DocumentName}";
    private string DocumentSequenceLabel => FixedSourceId is 5 or 6 ? "رقم الفاتورة" : "رقم السند";
    private string LookupPickerTitle => activeLookupKind switch
    {
        "source" => "اختيار نوع القيد",
        "card" => "اختيار جهة التعامل",
        "method" => "اختيار طريقة الدفع",
        "bank" => "اختيار البنك",
        "center1" => "اختيار مركز 1",
        "center2" => "اختيار مركز 2",
        "center3" => "اختيار المركز الفرعي",
        "vat" => "اختيار معدل الضريبة",
        _ => "اختيار سجل"
    };

    private List<LookupItem> FilteredLookupItems
    {
        get
        {
            IEnumerable<LookupItem> query = GetLookupItems();
            if (!string.IsNullOrWhiteSpace(lookupSearchText))
            {
                var term = lookupSearchText.Trim();
                query = query.Where(item =>
                    item.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || item.Code.Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.OrderBy(item => item.Name).ThenBy(item => item.Id).ToList();
        }
    }
    private List<AccEntity> FilteredAccounts
    {
        get
        {
            IEnumerable<AccEntity> query = accounts.Where(account => account.Active == true);

            if (!string.IsNullOrWhiteSpace(accountSearchText))
            {
                var term = accountSearchText.Trim();
                query = query.Where(account =>
                    account.ACCID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (!string.IsNullOrWhiteSpace(account.Name)
                        && account.Name.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            return query
                .OrderBy(account => account.Name)
                .ThenBy(account => account.ACCID)
                .ToList();
        }
    }

    private List<JournalEntryVm> FilteredPreviousEntries
    {
        get
        {
            IEnumerable<JournalEntryVm> query = previousEntries;
            if (GLID.HasValue)
            {
                query = query.Where(entry => entry.GLID != GLID.Value);
            }

            if (!string.IsNullOrWhiteSpace(previousEntrySearchText))
            {
                var term = previousEntrySearchText.Trim();
                query = query.Where(entry =>
                    entry.GLID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (entry.SerialNo?.ToString().Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || entry.Description.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || entry.SourceName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || entry.CardName.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || GetDisplayDate(entry.Date).Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.Take(200).ToList();
        }
    }

    protected override void OnParametersSet()
    {
        if (!IsInvoiceSource)
        {
            activeSubrecordTab = AccountingDirectionTab;
        }
        else if (activeSubrecordTab != InvoiceDataTab && activeSubrecordTab != AccountingDirectionTab)
        {
            activeSubrecordTab = InvoiceDataTab;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadLookups();

        if (GLID.HasValue)
        {
            await LoadEntry(GLID.Value);
        }
        else if (IsOpeningSource)
        {
            try
            {
                var draft = await AccountingDataService.CreateOpeningEntryDraftAsync();
                glHeader = draft.Header;
                transactions = draft.Transactions;
                statusMessage = "تم تحميل أرصدة BALANCE من السنة السابقة. أضف فرق الربح أو الخسارة يدويًا ليصبح القيد متوازنًا قبل الحفظ.";
                AddTransaction();
            }
            catch (InvalidOperationException ex) { errorMessage = ex.Message; }
            catch { errorMessage = "تعذر تحميل الأرصدة الافتتاحية من السنة السابقة."; }
        }
        else if (transactions.Count == 0)
        {
            AddTransaction();
            AddTransaction();
        }
    }

    private async Task LoadLookups()
    {
        isLoading = true;
        try
        {
            settingsData = await AccountingDataService.GetSettingsDataAsync();
            selectedFinancialYear = settingsData.ActivePeriodStart?.Year;

            if (!glHeader.PeriodID.HasValue && SessionService.SelectedPeriodId.HasValue)
            {
                glHeader.PeriodID = SessionService.SelectedPeriodId.Value;
            }

            if (!glHeader.GLDate.HasValue && selectedFinancialYear.HasValue)
            {
                glHeader.GLDate = new DateTime(selectedFinancialYear.Value, 1, 1);
            }

            var lookupsTask = AccountingDataService.GetJournalEntryLookupsAsync();
            var lookups = await lookupsTask;
            accounts = lookups.Accounts;
            sources = lookups.Sources;
            cards = lookups.Cards;
            methods = lookups.Methods;
            banks = lookups.Banks;
            centers1 = lookups.Centers1;
            centers2 = lookups.Centers2;
            centers3 = lookups.Centers3;
            vatRates = lookups.VatRates;
            if (!GLID.HasValue && (IsDocumentSource || IsOpeningSource))
            {
                glHeader.SourceID = FixedSourceId;
            }
            else if (!GLID.HasValue && !glHeader.SourceID.HasValue)
            {
                var journalSource = sources.FirstOrDefault(source => source.SourceID == 1)
                    ?? sources.FirstOrDefault(source =>
                        string.Equals(source.Source?.Trim(), "قيد يومية", StringComparison.OrdinalIgnoreCase));
                glHeader.SourceID = journalSource?.SourceID;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex);
            errorMessage = "تعذر تحميل البيانات؛ حاول مرة أخرى أو راجع مسؤول النظام.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadEntry(int glid)
    {
        isLoading = true;
        try
        {
            var entry = await AccountingDataService.GetJournalEntryDetailAsync(glid);
            if (entry != null)
            {
                glHeader = entry.Header;
                if (IsInvoiceSource)
                {
                    transactions = entry.Transactions.Where(IsInvoiceDetailRow).ToList();
                    invoiceAccountingTransactions = entry.Transactions.ToList();
                }
                else
                {
                    transactions = entry.Transactions;
                }
                NormalizeTransactionAmounts();
                if (IsInvoiceSource && !invoiceAccountingTransactions.Any(transaction => !IsInvoiceDetailRow(transaction)))
                {
                    SyncAccountingDirection();
                }
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex);
            errorMessage = "تعذر تحميل القيد؛ حاول مرة أخرى أو راجع مسؤول النظام.";
        }
        finally
        {
