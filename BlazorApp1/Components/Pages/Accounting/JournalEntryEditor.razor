        if (credit > 0) displayedTransactions[index].DR = 0m;
    }

    private void OnDocumentDateChanged(int index, ChangeEventArgs e)
    {
        transactions[index].DocDate = DateTime.TryParse(e.Value?.ToString(), out var date) ? date : null;
        if (IsInvoiceSource) SyncAccountingDirection();
    }

    private void OnDisplayedDocumentDateChanged(int index, ChangeEventArgs e)
    {
        var displayedTransactions = IsInvoiceSource ? invoiceAccountingTransactions : transactions;
        displayedTransactions[index].DocDate = DateTime.TryParse(e.Value?.ToString(), out var date) ? date : null;
    }

    private void OpenDisplayedAccountPicker(int index)
    {
        if (IsInvoiceSource) OpenAccountingAccountPicker(index);
        else OpenAccountPicker(index);
    }

    private void OpenDisplayedCenterPicker(int index)
    {
        if (IsInvoiceSource) OpenAccountingLookupPicker("center3", index);
        else OpenLookupPicker("center3", index);
    }

    private void NormalizeTransactionAmounts()
    {
        foreach (var transaction in transactions)
        {
            transaction.DR ??= 0m;
            transaction.CR ??= 0m;
            if (IsInvoiceSource)
            {
                transaction.TaxRate ??= GetDefaultVatRate();
                transaction.Amount ??= 0m;
                RecalculateInvoiceAmounts(transaction);
            }
        }
    }

    private static decimal ParseDecimalOrZero(object? value)
        => ParseNonNegativeDecimal(value, 2);

    private static decimal ParseNonNegativeDecimal(object? value, int decimalPlaces)
    {
        var text = value?.ToString();
        if (decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var invariantValue)
            || decimal.TryParse(text, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out invariantValue))
        {
            return Math.Max(0m, decimal.Round(invariantValue, decimalPlaces, MidpointRounding.AwayFromZero));
        }

        return 0m;
    }

    private bool CanSave()
    {
        if (isLoading || isImporting) return false;
        if (transactions.Count == 0) return false;
        if (totalDebit != totalCredit) return false;
        if (IsInvoiceSource)
        {
            if (!glHeader.GLACC.HasValue) return false;
            if (transactions.Any(t => !t.ACCID.HasValue)) return false;
            if (invoiceAccountingTransactions.Count == 0 || invoiceAccountingTransactions.Any(t => !t.ACCID.HasValue)) return false;
        }
        else if (transactions.Any(t => !t.ACCID.HasValue)) return false;
        if (selectedFinancialYear.HasValue && glHeader.GLDate.HasValue && glHeader.GLDate.Value.Year != selectedFinancialYear.Value) return false;
        return true;
    }

    private async Task SaveEntry()
    {
        errorMessage = null;
        statusMessage = null;
        isLoading = true;

        try
        {
            if (IsDocumentSource || IsOpeningSource)
            {
                glHeader.SourceID = FixedSourceId;
            }

            if (selectedFinancialYear.HasValue && glHeader.GLDate.HasValue && glHeader.GLDate.Value.Year != selectedFinancialYear.Value)
            {
                errorMessage = $"تاريخ القيد يجب أن يكون ضمن سنة الفترة المالية المحددة ({selectedFinancialYear.Value}).";
                return;
            }

            var request = new JournalEntryUpsertVm
            {
                Header = glHeader,
                Transactions = IsInvoiceSource ? AccountingDirectionTransactions : transactions
            };

            var result = await AccountingDataService.SaveJournalEntryAsync(request);

            if (result.Success)
            {
                statusMessage = result.Message;

                if (!GLID.HasValue && result.EntityId.HasValue)
                {
                    Navigation.NavigateTo(BuildEditorUrl(result.EntityId.Value), replace: true);
                }
            }
            else
            {
                errorMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex);
            errorMessage = "تعذر حفظ القيد؛ حاول مرة أخرى أو راجع مسؤول النظام.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel()
    {
        Navigation.NavigateTo(SafeReturnUrl);
    }

    private string BuildEditorUrl(long glid) => IsDocumentSource || IsOpeningSource
        ? $"/accounting/journal-entry/{glid}?sourceId={FixedSourceId}&returnUrl={Uri.EscapeDataString(SafeReturnUrl)}"
        : $"/accounting/journal-entry/{glid}";

    private string SafeReturnUrl => !string.IsNullOrWhiteSpace(ReturnUrl)
                                    && ReturnUrl.StartsWith('/')
                                    && !ReturnUrl.StartsWith("//", StringComparison.Ordinal)
        ? ReturnUrl
        : "/accounting/journal-entries";

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var selectedDate))
        {
            return;
        }

        if (selectedFinancialYear.HasValue && selectedDate.Year != selectedFinancialYear.Value)
        {
            errorMessage = $"غير مسموح اختيار تاريخ خارج سنة الفترة المالية المحددة ({selectedFinancialYear.Value}).";
            return;
        }

        errorMessage = null;
        glHeader.GLDate = selectedDate;
    }

