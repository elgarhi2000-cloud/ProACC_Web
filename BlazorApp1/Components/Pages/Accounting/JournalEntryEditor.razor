@inject ReportDesignService Designs
@page "/accounting/journal-entry/new"
@page "/accounting/journal-entry/{GLID:int}"
@layout BlazorApp1.Components.Layout.AccountingLayout
@using BlazorApp1.Services
@using BlazorApp1.Data.ProAcc
@inject IAccountingDataService AccountingDataService
@inject ISessionService SessionService
@inject IUserAccessService Access
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@EditorTitle - النظام المحاسبي</PageTitle>

<div class="page-content journal-entry-page" dir="rtl">
    <div class="journal-entry-page-heading">
        <h3 class="page-title">
            <i class="bi bi-journal-text"></i>
            @EditorTitle
        </h3>
        <div class="journal-entry-heading-actions" role="group" aria-label="أدوات القيد">
            <JournalAttachments @key="glHeader.GLID" EntryId="glHeader.GLID" />
            @if (IsInvoiceSource)
            {
                <button type="button" class="journal-export-button journal-export-pdf" @onclick="() => showInvoicePrint = true" disabled="@isLoading">
                    <i class="bi bi-printer"></i><span>@(FixedSourceId == 5 ? "طباعة فاتورة المبيعات" : "طباعة فاتورة المشتريات")</span>
                </button>
            }
            <button type="button" class="journal-load-entry-button" @onclick="OpenPreviousEntryPicker" disabled="@IsOpeningSource">
                <i class="bi bi-copy"></i>
                <span>تحميل قيد سابق</span>
            </button>
            <button type="button" class="journal-export-button journal-export-pdf" @onclick="PrintJournalAsPdf" title="طباعة القيد بصيغة PDF">
                <i class="bi bi-file-earmark-pdf"></i>
                <span>طباعة PDF</span>
            </button>
            @if (glHeader.SourceID is 2 or 3)
            {
                <button type="button" class="journal-export-button journal-export-pdf" @onclick="PrintVoucher" disabled="@isLoading">
                    <i class="bi bi-printer"></i>
                    <span>@(glHeader.SourceID == 2 ? "طباعة سند القبض" : "طباعة سند الصرف")</span>
                </button>
            }
            <button type="button" class="journal-export-button journal-export-excel" @onclick="ExportJournalToExcel" title="تصدير القيد إلى Excel">
                <i class="bi bi-file-earmark-excel"></i>
                <span>تصدير Excel</span>
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Cancel"><i class="bi bi-arrow-right"></i>رجوع</button>
        </div>
    </div>

    @if (showInvoicePrint && IsInvoiceSource)
    {
        <InvoicePrintPanel Report="BuildJournalExportData()" Header="glHeader" Lines="transactions" IsPurchase="@(FixedSourceId == 6)" OnClose="() => showInvoicePrint = false" />
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    @if (isLoading)
    {
        <div class="alert alert-info">جاري التحميل...</div>
    }
    else
    {
        <section class="card journal-entry-header-card">
            <div class="card-header journal-entry-section-header">
                <h5 class="mb-0"><i class="bi bi-info-circle-fill"></i>بيانات رأس القيد</h5>
            </div>
            <div class="card-body journal-entry-header-body">
                <div class="journal-header-groups">
                    <section class="journal-header-group">
                        <div class="journal-entry-fields">
                            <div class="journal-entry-field">
                                <label>رقم القيد</label>
                                <input type="text" value="@(glHeader.GLID > 0 ? glHeader.GLID.ToString() : "تلقائي")" disabled />
                            </div>
                            <div class="journal-entry-field">
                                <label>تسلسل القيد</label>
                                <input type="text" value="@(glHeader.GLSN?.ToString() ?? "تلقائي")" readonly />
                            </div>
                            <div class="journal-entry-field">
                                <label>تاريخ القيد</label>
                                <input type="date" value="@GetDateValue(glHeader.GLDate)" @onchange="OnDateChanged" />
                            </div>
                            <div class="journal-entry-field">
                                <label>الفترة المالية</label>
                                <input type="text" value="@(glHeader.PeriodID?.ToString() ?? "-")" readonly />
                            </div>
                            <div class="journal-entry-field">
                                <label>نوع القيد</label>
                                @if (IsDocumentSource || IsOpeningSource)
                                {
                                    <input type="text" value="@GetSourceDisplay()" readonly />
                                }
                                else
                                {
                                    <button type="button" class="journal-search-control" @onclick='() => OpenLookupPicker("source")'>
                                        <span class="@(glHeader.SourceID.HasValue ? null : "is-placeholder")">@GetSourceDisplay()</span><i class="bi bi-search"></i>
                                    </button>
                                }
                            </div>
                            @if (IsDocumentSource)
                            {
                                <div class="journal-entry-field">
                                    <label>@DocumentSequenceLabel</label>
                                    <input type="text" value="@(glHeader.SanadID?.ToString() ?? "تلقائي")" readonly />
                                </div>
                            }
                            <div class="journal-entry-field">
                                <label>رقم المرجع</label>
                                <input type="text" @bind="glHeader.GLRef" />
                            </div>
                            <div class="journal-entry-field journal-entry-field-full journal-entry-description">
                                <label>بيان القيد</label>
                                <div class="journal-description-control">
                                    <input type="text" @bind="glHeader.GLDesc" placeholder="اكتب وصفاً واضحاً للقيد" />
                                    <button type="button"
                                            class="journal-copy-description-button"
                                            title="نسخ البيان وتاريخ القيد إلى جميع السطور"
                                            aria-label="نسخ بيان وتاريخ القيد إلى جميع السطور"
                                            disabled="@(transactions.Count == 0 || !glHeader.GLDate.HasValue)"
                                            @onclick="OpenHeaderDataCopyConfirmation">
                                        <i class="bi bi-copy"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="journal-header-group">
                        <div class="journal-entry-fields">
                            <div class="journal-entry-field">
                                <label>جهة التعامل</label>
                                <button type="button" class="journal-search-control" @onclick='() => OpenLookupPicker("card")'>
                                    <span class="@(glHeader.CardID.HasValue ? null : "is-placeholder")">@GetCardDisplay()</span><i class="bi bi-search"></i>
                                </button>
                            </div>
                            @if (IsInvoiceSource)
                            {
                                <div class="journal-entry-field">
                                    <label>@(FixedSourceId == 5 ? "الحساب المدين" : "الحساب الدائن")</label>
                                    <button type="button" class="journal-search-control" @onclick="OpenHeaderAccountPicker">
                                        <span class="@(glHeader.GLACC.HasValue ? null : "is-placeholder")">@GetHeaderAccountDisplay()</span><i class="bi bi-search"></i>
                                    </button>
                                </div>
                            }
                            else
                            {
                            <div class="journal-entry-grid-spacer" aria-hidden="true"></div>
                            }
                            <div class="journal-entry-field">
                                <label>اسم البنك</label>
                                <button type="button" class="journal-search-control" @onclick='() => OpenLookupPicker("bank")'>
                                    <span class="@(!string.IsNullOrWhiteSpace(glHeader.BankName) ? null : "is-placeholder")">@GetBankDisplay()</span><i class="bi bi-search"></i>
                                </button>
                            </div>
                            <div class="journal-entry-field">
                                <label>مركز 1</label>
                                <button type="button" class="journal-search-control" @onclick='() => OpenLookupPicker("center1")'>
                                    <span class="@(glHeader.Center1.HasValue ? null : "is-placeholder")">@GetCenter1Display()</span><i class="bi bi-search"></i>
                                </button>
                            </div>
                            <div class="journal-entry-field">
                                <label>طريقة الدفع</label>
                                <button type="button" class="journal-search-control" @onclick='() => OpenLookupPicker("method")'>
                                    <span class="@(glHeader.MethodID.HasValue ? null : "is-placeholder")">@GetMethodDisplay()</span><i class="bi bi-search"></i>
                                </button>
                            </div>
                            <div class="journal-entry-field">
                                <label>مركز 2</label>
                                <button type="button" class="journal-search-control" @onclick='() => OpenLookupPicker("center2")'>
                                    <span class="@(glHeader.Center2.HasValue ? null : "is-placeholder")">@GetCenter2Display()</span><i class="bi bi-search"></i>
                                </button>
                            </div>
                            <div class="journal-entry-field">
                                <label>المستخدم</label>
                                <input type="text" value="@glHeader.Info" readonly />
                            </div>
                            <div class="journal-entry-field">
                                <label>القيد مؤرشف</label>
                                <label class="journal-archive-check" aria-label="حالة أرشفة القيد">
                                    <input type="checkbox" @bind="glHeader.Archive" disabled="@(!Access.Has("Archive"))" />
                                </label>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </section>

        <section class="card journal-lines-card">
            @if (IsInvoiceSource)
            {
                <div class="journal-subrecord-tabs" role="tablist" aria-label="السجلات الفرعية للفاتورة">
                    <button type="button"
                            role="tab"
                            class="journal-subrecord-tab @(IsInvoiceDataTab ? "active" : null)"
                            aria-selected="@IsInvoiceDataTab"
                            @onclick='() => SelectSubrecordTab(InvoiceDataTab)'>
                        <i class="bi bi-receipt"></i>
                        <span>بيانات الفاتورة</span>
                    </button>
                    <button type="button"
                            role="tab"
                            class="journal-subrecord-tab @(!IsInvoiceDataTab ? "active" : null)"
                            aria-selected="@(!IsInvoiceDataTab)"
                            @onclick='() => SelectSubrecordTab(AccountingDirectionTab)'>
                        <i class="bi bi-diagram-3"></i>
                        <span>التوجيه المحاسبي</span>
                    </button>
                </div>
            }
            <div class="journal-lines-toolbar">
                <h5 class="journal-lines-toolbar-title">
                    <i class="bi @(IsInvoiceDataTab ? "bi-receipt-cutoff" : "bi-list-ul")"></i>
                    <span>@SubrecordSectionTitle</span>
                    <small>@ActiveTransactionCount سطر</small>
                </h5>
                @if (!IsInvoiceSource || IsInvoiceDataTab)
                {
                    <div class="d-flex align-items-center gap-2" style="margin-inline-start:auto">
                    @if (!IsInvoiceSource)
                    {
                        <label class="btn btn-outline-primary btn-sm mb-0" style="position:relative;overflow:hidden">
                            <i class="bi bi-upload"></i> استيراد CSV
                            <InputFile OnChange="ImportCsv" accept=".csv" disabled="@(isLoading || isImporting)"
                                       aria-label="استيراد سجلات القيد من CSV"
                                       style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%" />
                        </label>
                    }
                    <button class="btn btn-primary btn-sm" @onclick="AddTransaction">
                        <i class="bi bi-plus-lg"></i>@(IsInvoiceDataTab ? "إضافة صنف" : "إضافة سطر")
                    </button>
                    </div>
                }
            </div>
            <div class="journal-lines-body">
                @if (ActiveTransactionCount == 0)
                {
                    <button class="journal-empty-lines" @onclick="AddTransaction"><i class="bi bi-plus-circle"></i><span>@(IsInvoiceDataTab ? "أضف أول صنف للفاتورة" : "أضف أول سطر للقيد")</span></button>
                }
                else if (IsInvoiceDataTab)
                {
                    <div class="table-responsive journal-lines-table-wrap">
                        <table id="invoice-lines-table" class="table journal-lines-table invoice-lines-table">
                            <thead>
                                <tr>
                                    <th class="journal-col-index" data-min-width="36" data-max-width="80">#<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="invoice-col-item" data-min-width="100" data-max-width="180">كود الصنف<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-description" data-min-width="150" data-max-width="360">الوصف<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="invoice-col-qty" data-min-width="85" data-max-width="160">الكمية<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="invoice-col-money" data-min-width="120" data-max-width="210">المبلغ قبل الضريبة<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="invoice-col-rate" data-min-width="105" data-max-width="180">معدل الضريبة<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="invoice-col-money" data-min-width="105" data-max-width="200">مبلغ الضريبة<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="invoice-col-money" data-min-width="120" data-max-width="210">المبلغ الإجمالي<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-account" data-min-width="150" data-max-width="360">اسم الحساب<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-doc-ref" data-min-width="100" data-max-width="220">رقم المستند<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-doc-date" data-min-width="120" data-max-width="180">تاريخ المستند<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-center" data-min-width="140" data-max-width="320">مركز فرعي<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-actions" data-min-width="96" data-max-width="180">الإجراءات<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < transactions.Count; i++)
                                {
                                    var idx = i;
                                    var trans = transactions[idx];
                                    <tr @key="trans">
                                        <td class="journal-row-index">@(idx + 1)</td>
                                        <td><input type="text" class="journal-line-input invoice-number-input" value="@trans.ItemCode" @onchange="@(e => OnItemCodeChanged(idx, e))" /></td>
                                        <td><input type="text" class="journal-line-input" @bind="trans.TransDesc" @bind:after="SyncAccountingDirection" /></td>
                                        <td><input type="number" min="0" step="0.0001" class="journal-line-input journal-money-input" value="@GetFlexibleDecimalValue(trans.Qty)" @onchange='@(e => OnInvoiceDecimalChanged(idx, "qty", e))' /></td>
                                        <td><input type="text" inputmode="decimal" class="journal-line-input journal-money-input" value="@GetDecimalValue(trans.Amount)" @onchange='@(e => OnInvoiceDecimalChanged(idx, "amount", e))' /></td>
                                        <td>
                                            <button type="button" class="journal-account-control" @onclick='() => OpenLookupPicker("vat", idx)'>
                                                <span>@GetTaxRateDisplay(trans.TaxRate)</span><i class="bi bi-search"></i>
                                            </button>
                                        </td>
                                        <td><input type="text" class="journal-line-input journal-money-input journal-calculated-input" value="@GetDecimalValue(trans.TaxAmount)" readonly tabindex="-1" /></td>
                                        <td><input type="text" class="journal-line-input journal-money-input invoice-total-input journal-calculated-input" value="@GetDecimalValue(trans.TotalAmount)" readonly tabindex="-1" /></td>
                                        <td>
                                            <button type="button" class="journal-account-control @(trans.ACCID.HasValue ? null : "empty")" @onclick="() => OpenAccountPicker(idx)">
                                                <span>@GetAccountName(trans.ACCID)</span><i class="bi bi-search"></i>
                                            </button>
                                        </td>
                                        <td><input type="text" class="journal-line-input" @bind="trans.DocRef" @bind:after="SyncAccountingDirection" /></td>
                                        <td><input type="date" class="journal-line-input journal-date-input" value="@GetDateValue(trans.DocDate)" @onchange="@(e => OnDocumentDateChanged(idx, e))" /></td>
                                        <td>
                                            <button type="button" class="journal-account-control @(trans.Center3.HasValue ? null : "empty")" @onclick='() => OpenLookupPicker("center3", idx)'>
                                                <span>@GetCenter3Display(trans.Center3)</span><i class="bi bi-search"></i>
                                            </button>
                                        </td>
                                        <td>
                                            <div class="entry-actions" role="group" aria-label="إجراءات صنف الفاتورة رقم @(idx + 1)">
                                                <button type="button" class="action-btn action-move" title="نقل الصنف إلى أعلى" aria-label="نقل الصنف رقم @(idx + 1) إلى أعلى" disabled="@(idx == 0)" @onclick="() => MoveTransaction(idx, idx - 1)"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                                                <button type="button" class="action-btn action-move" title="نقل الصنف إلى أسفل" aria-label="نقل الصنف رقم @(idx + 1) إلى أسفل" disabled="@(idx == transactions.Count - 1)" @onclick="() => MoveTransaction(idx, idx + 1)"><i class="bi bi-arrow-down" aria-hidden="true"></i></button>
                                                <button type="button" class="action-btn action-delete" title="حذف الصنف" aria-label="حذف الصنف رقم @(idx + 1)" @onclick="() => RemoveTransaction(idx)"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="4" class="text-end">الإجماليات</th>
                                    <th>@invoiceAmountTotal.ToString("N2")</th>
                                    <th></th>
                                    <th>@invoiceTaxTotal.ToString("N2")</th>
                                    <th class="invoice-grand-total">@invoiceGrandTotal.ToString("N2")</th>
                                    <th colspan="5"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    var displayedTransactions = IsInvoiceSource ? AccountingDirectionTransactions : transactions;
                    <div class="table-responsive journal-lines-table-wrap">
                        <table id="journal-lines-table" class="table journal-lines-table">
                            <thead>
                                <tr>
                                    <th class="journal-col-index" data-min-width="36" data-max-width="80">#<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-code" data-min-width="90" data-max-width="220">رقم الحساب<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-account" data-min-width="150" data-max-width="420">اسم الحساب<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-description" data-min-width="210" data-max-width="480">الوصف<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-money" data-min-width="95" data-max-width="220">مدين<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-money" data-min-width="95" data-max-width="220">دائن<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-doc-ref" data-min-width="85" data-max-width="220">رقم المستند<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-doc-date" data-min-width="110" data-max-width="180">تاريخ المستند<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-center" data-min-width="135" data-max-width="360">مركز فرعي<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                    <th class="journal-col-actions" data-min-width="96" data-max-width="180">الإجراءات<span class="journal-column-resizer" title="اسحب لتغيير العرض، وانقر مرتين للملاءمة التلقائية"></span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < displayedTransactions.Count; i++)
                                {
                                    var idx = i;
                                    var trans = displayedTransactions[idx];
                                    <tr @key="trans">
                                        <td class="journal-row-index">@(idx + 1)</td>
                                        <td class="journal-account-code">@GetAccountCode(trans.ACCID)</td>
                                        <td>
                                            <button type="button" class="journal-account-control @(trans.ACCID.HasValue ? null : "empty")" @onclick="() => OpenDisplayedAccountPicker(idx)">
                                                <span>@GetAccountName(trans.ACCID)</span><i class="bi bi-search"></i>
                                            </button>
                                        </td>
                                        <td>
                                            <input type="text" class="journal-line-input journal-line-description" @bind="trans.TransDesc" placeholder="وصف الحركة" />
                                        </td>
                                        <td>
                                            <input type="text" inputmode="decimal" class="journal-line-input journal-money-input debit" value="@GetDecimalValue(trans.DR)" @onchange="@(e => OnDisplayedDebitChange(idx, e))" />
                                        </td>
                                        <td>
                                            <input type="text" inputmode="decimal" class="journal-line-input journal-money-input credit" value="@GetDecimalValue(trans.CR)" @onchange="@(e => OnDisplayedCreditChange(idx, e))" />
                                        </td>
                                        <td>
                                            <input type="text" class="journal-line-input" @bind="trans.DocRef" />
                                        </td>
                                        <td>
                                            <input type="date" class="journal-line-input journal-date-input" value="@GetDateValue(trans.DocDate)" @onchange="@(e => OnDisplayedDocumentDateChanged(idx, e))" />
                                        </td>
                                        <td>
                                            <button type="button" class="journal-account-control @(trans.Center3.HasValue ? null : "empty")" @onclick="() => OpenDisplayedCenterPicker(idx)">
                                                <span>@GetCenter3Display(trans.Center3)</span><i class="bi bi-search"></i>
                                            </button>
                                        </td>
                                        <td>
                                            @if (IsInvoiceSource)
                                            {
                                                <span class="journal-generated-badge"><i class="bi bi-pencil-square"></i> قابل للتعديل</span>
                                            }
                                            else
                                            {
                                                <div class="entry-actions" role="group" aria-label="إجراءات السطر رقم @(idx + 1)">
                                                <button type="button"
                                                        class="action-btn action-move"
                                                        title="نقل السطر إلى أعلى"
                                                        aria-label="نقل السطر رقم @(idx + 1) إلى أعلى"
                                                        disabled="@(idx == 0)"
                                                        @onclick="() => MoveDisplayedTransaction(idx, idx - 1)">
                                                    <i class="bi bi-arrow-up" aria-hidden="true"></i>
                                                </button>
                                                <button type="button"
                                                        class="action-btn action-move"
                                                        title="نقل السطر إلى أسفل"
                                                        aria-label="نقل السطر رقم @(idx + 1) إلى أسفل"
                                                        disabled="@(idx == displayedTransactions.Count - 1)"
                                                        @onclick="() => MoveDisplayedTransaction(idx, idx + 1)">
                                                    <i class="bi bi-arrow-down" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="action-btn action-delete" title="حذف السطر" aria-label="حذف السطر رقم @(idx + 1)" @onclick="() => RemoveDisplayedTransaction(idx)">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                </button>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="4" class="text-end">الإجمالي</th>
                                    <th class="journal-total-debit">@totalDebit.ToString("N2")</th>
                                    <th class="journal-total-credit">@totalCredit.ToString("N2")</th>
                                    <th colspan="4"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </section>

        <div class="journal-entry-footer">
            <div class="journal-balance-status @(IsBalanced ? "balanced" : "unbalanced")">
                <i class="bi @(IsBalanced ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
                <span>@(IsBalanced ? "القيد متوازن" : $"القيد غير متوازن — الفرق {BalanceDifference:N2}")</span>
            </div>
            <div class="journal-entry-footer-actions">
                <button class="btn btn-outline-secondary" @onclick="Cancel"><i class="bi bi-x-lg"></i>إلغاء</button>
            <button class="btn btn-primary" @onclick="SaveEntry" disabled="@(!CanSave())">
                    <i class="bi bi-check2-circle"></i>حفظ القيد
            </button>
            </div>
        </div>
    }
</div>

