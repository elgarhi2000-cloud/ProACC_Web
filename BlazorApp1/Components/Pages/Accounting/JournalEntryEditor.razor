    private async Task ChangeCopyPeriod(ChangeEventArgs e)
    {
        if (isLoadingPreviousEntries || !int.TryParse(e.Value?.ToString(), out var periodId)) return;
        copyPeriodId = periodId;
        previousEntries.Clear();
        isLoadingPreviousEntries = true;
        try { previousEntries = (await AccountingDataService.GetCopyableJournalEntriesAsync(copyPeriodId)).ToList(); }
        catch { errorMessage = "تعذر تحميل قيود الفترة المحددة."; ClosePreviousEntryPicker(); }
        finally { isLoadingPreviousEntries = false; }
    }

    private async Task OpenPreviousEntryPicker()
    {
        errorMessage = null;
        statusMessage = null;
        previousEntrySearchText = string.Empty;
        showPreviousEntryPicker = true;
        isLoadingPreviousEntries = true;

        try
        {
            var periods = await AccountingDataService.GetFinancialPeriodsAsync();
            var current = periods.FirstOrDefault(p => p.PeriodId == SessionService.SelectedPeriodId);
            copyPeriods = periods.Where(p => p.PeriodId == SessionService.SelectedPeriodId
                || (current?.StartDate is DateTime start && p.EndDate.HasValue && p.EndDate.Value < start)).ToList();
            copyPeriodId = SessionService.SelectedPeriodId ?? 0;
            previousEntries = (await AccountingDataService.GetCopyableJournalEntriesAsync(copyPeriodId)).ToList();
        }
        catch (Exception ex)
        {
            showPreviousEntryPicker = false;
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex);
            errorMessage = "تعذر تحميل القيود السابقة؛ حاول مرة أخرى أو راجع مسؤول النظام.";
