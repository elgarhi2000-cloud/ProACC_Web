    private async Task PrintVoucher()
    {
        errorMessage = null;
        try
        {
            var debit = transactions.Sum(t => t.DR ?? 0m);
            var credit = transactions.Sum(t => t.CR ?? 0m);
            if (debit <= 0 || debit != credit)
            {
                errorMessage = "يجب أن يكون السند متوازنًا وبمبلغ أكبر من صفر قبل الطباعة.";
                return;
            }
            var printReport = BuildJournalExportData();
            printReport.Design = await Designs.ForPrintAsync(glHeader.SourceID == 2 ? "receipt" : "payment");
            await JS.InvokeVoidAsync("journalEntryExport.print", printReport, new
            {
                title = glHeader.SourceID == 2 ? "سند قبض" : "سند صرف",
                number = glHeader.SanadID,
                amount = decimal.Round(debit, 2),
                isReceipt = glHeader.SourceID == 2
            });
        }
        catch (Exception ex)
        {
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex);
            errorMessage = "تعذرت طباعة السند؛ حاول مرة أخرى أو راجع مسؤول النظام.";
        }
    }

