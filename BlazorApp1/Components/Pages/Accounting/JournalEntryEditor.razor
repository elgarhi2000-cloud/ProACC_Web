    private async Task CopyPreviousEntry(int sourceGlid)
    {
        isLoadingPreviousEntries = true;
        errorMessage = null;

        try
        {
            var sourceEntry = await AccountingDataService.GetJournalEntryForCopyAsync(sourceGlid, copyPeriodId);
            if (sourceEntry is null)
            {
                errorMessage = "القيد المحدد لم يعد موجوداً.";
                ClosePreviousEntryPicker();
                return;
            }

            glHeader.SourceID = sourceEntry.Header.SourceID;
            if (IsDocumentSource || IsOpeningSource)
            {
                glHeader.SourceID = FixedSourceId;
            }
            glHeader.GLDesc = sourceEntry.Header.GLDesc;
            glHeader.GLRef = sourceEntry.Header.GLRef;
            glHeader.GLACC = sourceEntry.Header.GLACC;
            glHeader.CardID = sourceEntry.Header.CardID;
            glHeader.MethodID = sourceEntry.Header.MethodID;
            glHeader.BankName = sourceEntry.Header.BankName;
            glHeader.Center1 = sourceEntry.Header.Center1;
            glHeader.Center2 = sourceEntry.Header.Center2;

            var sourceTransactions = IsInvoiceSource
                ? sourceEntry.Transactions.Where(IsInvoiceDetailRow)
                : sourceEntry.Transactions;

            transactions = sourceTransactions
                .Select(transaction => new TransEntity
                {
                    GLID = glHeader.GLID > 0 ? glHeader.GLID : null,
                    ACCID = transaction.ACCID,
                    DR = transaction.DR ?? 0m,
                    CR = transaction.CR ?? 0m,
                    TransDesc = transaction.TransDesc,
                    ItemCode = transaction.ItemCode,
                    Amount = transaction.Amount,
                    TaxRate = transaction.TaxRate,
                    TaxAmount = transaction.TaxAmount,
                    TotalAmount = transaction.TotalAmount,
                    Qty = transaction.Qty,
                    Unit = transaction.Unit,
                    UnitPrice = transaction.UnitPrice,
                    Discount = transaction.Discount,
                    DocRef = transaction.DocRef,
                    DocDate = transaction.DocDate,
                    Center3 = transaction.Center3
                })
                .ToList();

            NormalizeTransactionAmounts();
            if (IsInvoiceSource)
            {
                SyncAccountingDirection();
            }

            if (transactions.Count == 0)
            {
                AddTransaction();
                AddTransaction();
            }

            statusMessage = $"تم تحميل بيانات القيد رقم {sourceGlid}. راجع البيانات ثم احفظ القيد.";
            ClosePreviousEntryPicker();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Trace.TraceError("Page operation failed: {0}", ex);
            errorMessage = "تعذر نسخ بيانات القيد؛ حاول مرة أخرى أو راجع مسؤول النظام.";
            ClosePreviousEntryPicker();
        }
        finally
        {
            isLoadingPreviousEntries = false;
        }
    }

    private IEnumerable<LookupItem> GetLookupItems()
        => activeLookupKind switch
        {
            "source" => sources.Select(item => new LookupItem(item.SourceID, item.Source ?? $"مصدر {item.SourceID}", item.SourceCode ?? item.SourceID.ToString())),
            "card" => cards.Select(item => new LookupItem(item.CardID, item.CardName ?? $"بطاقة {item.CardID}", (item.CardNum ?? item.CardID).ToString())),
            "method" => methods.Select(item => new LookupItem(item.MethodID, item.MethodName ?? $"طريقة {item.MethodID}", item.MethodID.ToString())),
            "bank" => banks.Select(item => new LookupItem(item.BankID, item.BankName ?? $"بنك {item.BankID}", item.BankID.ToString())),
            "center1" => centers1.Select(item => new LookupItem(item.CenterID, item.CenterName ?? $"مركز {item.CenterID}", item.CenterID.ToString())),
            "center2" => centers2.Select(item => new LookupItem(item.CenterID, item.CenterName ?? $"مركز {item.CenterID}", item.CenterID.ToString())),
            "center3" => centers3.Select(item => new LookupItem(item.CenterID, item.CenterName ?? $"مركز فرعي {item.CenterID}", item.CenterID.ToString())),
            "vat" => vatRates
                .Where(item => item.TaxRate.HasValue)
                .Select(item => new LookupItem(
                    item.Id,
                    $"{GetFlexibleDecimalValue(item.TaxRate)}%",
                    GetFlexibleDecimalValue(item.TaxRate))),
            _ => Enumerable.Empty<LookupItem>()
        };

    private void SelectLookupItem(int itemId)
    {
        switch (activeLookupKind)
        {
            case "source": glHeader.SourceID = itemId; break;
            case "card": glHeader.CardID = itemId; break;
            case "method": glHeader.MethodID = itemId; break;
            case "bank":
                glHeader.BankName = banks.FirstOrDefault(item => item.BankID == itemId)?.BankName;
                break;
            case "center1": glHeader.Center1 = itemId; break;
            case "center2": glHeader.Center2 = itemId; break;
            case "center3" when IsLookupTransactionValid():
                GetLookupTransaction().Center3 = itemId;
                if (!lookupTargetsAccountingDirection) SyncAccountingDirection();
                break;
            case "vat" when IsLookupTransactionValid():
                transactions[lookupTransactionIndex].TaxRate = vatRates.FirstOrDefault(item => item.Id == itemId)?.TaxRate ?? GetDefaultVatRate();
                RecalculateInvoiceAmounts(transactions[lookupTransactionIndex]);
                SyncAccountingDirection();
                break;
        }

        CloseLookupPicker();
    }

    private void ClearLookupSelection()
    {
        switch (activeLookupKind)
        {
            case "source": glHeader.SourceID = null; break;
            case "card": glHeader.CardID = null; break;
            case "method": glHeader.MethodID = null; break;
            case "bank": glHeader.BankName = null; break;
            case "center1": glHeader.Center1 = null; break;
            case "center2": glHeader.Center2 = null; break;
            case "center3" when IsLookupTransactionValid():
                GetLookupTransaction().Center3 = null;
                if (!lookupTargetsAccountingDirection) SyncAccountingDirection();
                break;
        }

        CloseLookupPicker();
    }

    private bool IsLookupItemSelected(int itemId)
        => activeLookupKind switch
        {
            "source" => glHeader.SourceID == itemId,
            "card" => glHeader.CardID == itemId,
            "method" => glHeader.MethodID == itemId,
            "bank" => string.Equals(
                glHeader.BankName,
                banks.FirstOrDefault(item => item.BankID == itemId)?.BankName,
                StringComparison.OrdinalIgnoreCase),
            "center1" => glHeader.Center1 == itemId,
            "center2" => glHeader.Center2 == itemId,
            "center3" => IsLookupTransactionValid() && GetLookupTransaction().Center3 == itemId,
            "vat" => IsLookupTransactionValid()
                && vatRates.FirstOrDefault(item => item.Id == itemId)?.TaxRate == transactions[lookupTransactionIndex].TaxRate,
            _ => false
        };

    private bool IsLookupTransactionValid()
        => lookupTransactionIndex >= 0
           && lookupTransactionIndex < (lookupTargetsAccountingDirection ? invoiceAccountingTransactions.Count : transactions.Count);

    private TransEntity GetLookupTransaction()
        => lookupTargetsAccountingDirection
            ? invoiceAccountingTransactions[lookupTransactionIndex]
            : transactions[lookupTransactionIndex];

    private void OnItemCodeChanged(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= transactions.Count)
        {
            return;
        }

        var text = e.Value?.ToString()?.Trim();
        transactions[index].ItemCode = string.IsNullOrWhiteSpace(text) ? null : text;
        SyncAccountingDirection();
    }

    private void OnInvoiceDecimalChanged(int index, string field, ChangeEventArgs e)
    {
        if (index < 0 || index >= transactions.Count)
        {
            return;
        }

        var value = ParseNonNegativeDecimal(e.Value, field == "qty" ? 4 : 2);
        var transaction = transactions[index];

        switch (field)
        {
            case "amount": transaction.Amount = value; break;
            case "qty": transaction.Qty = value; break;
        }

        RecalculateInvoiceAmounts(transaction);
        SyncAccountingDirection();
    }

    private decimal GetDefaultVatRate()
        => vatRates.FirstOrDefault(item => item.TaxRate == DefaultVatRate)?.TaxRate ?? DefaultVatRate;

    private static void RecalculateInvoiceAmounts(TransEntity transaction)
    {
        var amount = transaction.Amount ?? 0m;
        var taxRate = transaction.TaxRate ?? DefaultVatRate;
        transaction.TaxAmount = decimal.Round(amount * taxRate / 100m, 2, MidpointRounding.AwayFromZero);
        transaction.TotalAmount = decimal.Round(amount + transaction.TaxAmount.Value, 2, MidpointRounding.AwayFromZero);
    }

    private static bool IsInvoiceDetailRow(TransEntity transaction)
        => !string.IsNullOrWhiteSpace(transaction.ItemCode)
           || transaction.Amount.HasValue
           || transaction.TaxRate.HasValue
           || transaction.TaxAmount.HasValue
           || transaction.TotalAmount.HasValue
           || transaction.Qty.HasValue;

    private List<TransEntity> BuildAccountingDirection()
    {
        if (!IsInvoiceSource)
        {
            return transactions;
        }

        var isSalesInvoice = FixedSourceId == 5;
        var direction = new List<TransEntity>
        {
            new()
            {
                ACCID = glHeader.GLACC,
                DR = isSalesInvoice ? invoiceGrandTotal : 0m,
                CR = isSalesInvoice ? 0m : invoiceGrandTotal,
                TransDesc = isSalesInvoice ? "إجمالي فاتورة المبيعات" : "إجمالي فاتورة المشتريات"
            }
        };

        direction.AddRange(transactions.Select(line => new TransEntity
        {
            ACCID = line.ACCID,
            DR = isSalesInvoice ? 0m : line.Amount ?? 0m,
            CR = isSalesInvoice ? line.Amount ?? 0m : 0m,
            TransDesc = line.TransDesc,
            ItemCode = line.ItemCode,
            Amount = line.Amount,
            TaxRate = line.TaxRate,
            TaxAmount = line.TaxAmount,
            TotalAmount = line.TotalAmount,
            Qty = line.Qty,
            Unit = line.Unit,
            UnitPrice = line.UnitPrice,
            Discount = line.Discount,
            DocRef = line.DocRef,
            DocDate = line.DocDate,
            Center3 = line.Center3
        }));

        direction.Add(new TransEntity
        {
            ACCID = GetInvoiceTaxAccountId(),
            DR = isSalesInvoice ? 0m : invoiceTaxTotal,
            CR = isSalesInvoice ? invoiceTaxTotal : 0m,
            TransDesc = isSalesInvoice ? "ضريبة المبيعات" : "ضريبة المشتريات"
        });

        return direction;
    }

    private void SyncAccountingDirection()
    {
        if (IsInvoiceSource)
        {
            invoiceAccountingTransactions = BuildAccountingDirection();
            tableColumnsInitialized = false;
        }
    }

    private long? GetInvoiceTaxAccountId()
    {
        foreach (var line in transactions)
        {
            var vat = vatRates.FirstOrDefault(item => item.TaxRate == line.TaxRate);
            var accountId = FixedSourceId == 5 ? vat?.SalesTaxACC : vat?.PurchTaxACC;
            if (accountId.HasValue)
            {
                return accountId;
            }
        }

        var fallbackVat = vatRates.FirstOrDefault(item => item.TaxRate == GetDefaultVatRate()) ?? vatRates.FirstOrDefault();
        return FixedSourceId == 5 ? fallbackVat?.SalesTaxACC : fallbackVat?.PurchTaxACC;
    }

