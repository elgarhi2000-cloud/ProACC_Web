    private void RemoveDisplayedTransaction(int index)
    {
        if (IsInvoiceSource && !IsInvoiceDataTab)
        {
            if (index >= 0 && index < invoiceAccountingTransactions.Count)
            {
                invoiceAccountingTransactions.RemoveAt(index);
                tableColumnsInitialized = false;
            }
            return;
        }

        RemoveTransaction(index);
    }

    private void MoveTransaction(int sourceIndex, int targetIndex)
    {
        if (sourceIndex < 0
            || sourceIndex >= transactions.Count
            || targetIndex < 0
            || targetIndex >= transactions.Count
            || sourceIndex == targetIndex)
        {
            return;
        }

        var transaction = transactions[sourceIndex];
        transactions.RemoveAt(sourceIndex);
        transactions.Insert(targetIndex, transaction);
        if (IsInvoiceSource) SyncAccountingDirection();
        tableColumnsInitialized = false;
    }

    private void MoveDisplayedTransaction(int sourceIndex, int targetIndex)
    {
        var displayedTransactions = IsInvoiceSource && !IsInvoiceDataTab
            ? invoiceAccountingTransactions
            : transactions;

        if (sourceIndex < 0
            || sourceIndex >= displayedTransactions.Count
            || targetIndex < 0
            || targetIndex >= displayedTransactions.Count
            || sourceIndex == targetIndex)
        {
            return;
        }

        var transaction = displayedTransactions[sourceIndex];
        displayedTransactions.RemoveAt(sourceIndex);
        displayedTransactions.Insert(targetIndex, transaction);
        tableColumnsInitialized = false;
    }

