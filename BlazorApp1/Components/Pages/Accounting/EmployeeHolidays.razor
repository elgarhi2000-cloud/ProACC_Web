        <div class="page-toolbar-actions"><SectionOutlet SectionId="@toolbarSection" /></div>
    </div>
    <MasterDataManager ToolbarSection="@toolbarSection" SectionKey="holidays" />
</div>

@code {
    private readonly object toolbarSection = new();
}
