@page "/accounting/hr/holidays"
@layout BlazorApp1.Components.Layout.AccountingLayout

<PageTitle>إجازات الموظفين - النظام المحاسبي</PageTitle>

<div class="page-content" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title"><i class="bi bi-calendar-check me-2"></i>إجازات الموظفين</h3>
            <p class="text-muted mb-0 mt-2">تسجيل الإجازات وربطها بالموظف ونوع الإجازة والفترة</p>
