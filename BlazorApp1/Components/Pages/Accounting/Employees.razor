@page "/accounting/hr/employees"
@layout BlazorApp1.Components.Layout.AccountingLayout

<PageTitle>تعريف الموظفين - النظام المحاسبي</PageTitle>

<div class="page-content" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="page-title"><i class="bi bi-person-badge me-2"></i>تعريف الموظفين</h3>
            <p class="text-muted mb-0 mt-2">إدارة البيانات الشخصية والوظيفية والمالية للموظفين</p>
        </div>
        <div class="page-toolbar-actions"><SectionOutlet SectionId="@toolbarSection" /></div>
    </div>
    <MasterDataManager ToolbarSection="@toolbarSection" SectionKey="employees" UseCardLayout="true" />
</div>

@code {
    private readonly object toolbarSection = new();
}
