@code {
    private static DateTime Today => DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(3)).Date;
    private static readonly CultureInfo ArabicDateCulture = CreateDateCulture(new GregorianCalendar());
    private static readonly CultureInfo HijriDateCulture = CreateDateCulture(new UmAlQuraCalendar());

    private static CultureInfo CreateDateCulture(Calendar calendar)
    {
        var culture = new CultureInfo("ar-SA");
        culture.DateTimeFormat.Calendar = calendar;
        return culture;
    }

    private DashboardDataVm? data;
    private List<JournalEntryVm> filteredEntries = new();
    private bool isLoading = true;
    private string? errorMessage;
    private string searchText = string.Empty;
    private string? level0PieTooltip;
    private List<Level0BalanceVm> level0BalanceCards = new();
    private static readonly string[] Level0PieColors =
        ["#4f46e5", "#0ea5e9", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#14b8a6", "#f97316"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            data = await AccountingDataService.GetDashboardDataAsync();
            filteredEntries = data.RecentEntries.ToList();
            level0BalanceCards = data.Level0Balances
                .OrderByDescending(x => Math.Abs(x.Net))
                .ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"تعذر تحميل الصفحة الرئيسية: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatCurrency(decimal value) => value.ToString("N2");

    private static string FormatCompactCurrency(decimal value) => value.ToString("N0");

    private static string FormatCompactNumber(decimal value)
    {
        var absolute = Math.Abs(value);
        if (absolute >= 1_000_000m) return $"{value / 1_000_000m:0.##}M";
        if (absolute >= 1_000m) return $"{value / 1_000m:0.#}K";
        return value.ToString("N0");
    }

    private IReadOnlyList<FinancialKpiVm> GetFinancialKpis()
    {
        var assets = GetNamedBalance(false, "أصول", "موجود", "asset");
        var expenses = GetNamedBalance(false, "مصروف", "مصاريف", "تكاليف", "expense");
        var revenues = GetNamedBalance(true, "إيراد", "ايراد", "دخل", "مبيعات", "revenue");
        var net = revenues - expenses;
        var maximum = new[] { Math.Abs(assets), Math.Abs(expenses), Math.Abs(revenues), Math.Abs(net) }.Max();

        return
        [
            CreateKpi("إجمالي الأصول", assets, "bi-safe2-fill", "#e7a334", maximum, "قيمة الأصول المسجلة", "من إجمالي الأرصدة"),
            CreateKpi("إجمالي المصروفات", expenses, "bi-receipt-cutoff", "#3964df", maximum, "المصروفات خلال الفترة", "حركة المصروفات الحالية"),
            CreateKpi("إجمالي الإيرادات", revenues, "bi-cash-stack", "#54b487", maximum, "الإيرادات خلال الفترة", "حركة الإيرادات الحالية"),
            CreateKpi(net >= 0 ? "فائض الفترة (الربحية)" : "عجز الفترة", net, net >= 0 ? "bi-graph-up-arrow" : "bi-graph-down-arrow", net >= 0 ? "#8258e8" : "#e3534d", maximum, net >= 0 ? "تحول للفائض" : "الفترة تسجل عجزًا", "صافي الإيرادات بعد المصروفات")
        ];
    }

    private static FinancialKpiVm CreateKpi(
        string title, decimal value, string icon, string color, decimal maximum, string detail, string footnote)
    {
        var progress = maximum == 0 ? 0 : Math.Abs(value) / maximum * 100m;
        return new FinancialKpiVm(title, value, icon, color, detail,
            $"{progress:0.#}%", value >= 0 ? "bi-graph-up-arrow" : "bi-graph-down-arrow", progress, footnote);
    }

    private decimal GetNamedBalance(bool creditNature, params string[] keywords)
        => level0BalanceCards
            .Where(x => keywords.Any(keyword => x.Level0Name.Contains(keyword, StringComparison.OrdinalIgnoreCase)))
            .Sum(x => creditNature ? x.Credit - x.Debit : x.Debit - x.Credit);

    private static string GetKpiStyle(FinancialKpiVm item)
        => $"--accent:{item.Color};--progress:{item.Progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";

    private IReadOnlyList<Level0BalanceVm> GetComparisonBalances()
        => level0BalanceCards.Take(6).ToList();

    private string GetComparisonBarStyle(decimal value)
    {
        var balances = GetComparisonBalances();
        var maximum = balances.Count == 0
            ? 0m
            : balances.Max(x => new[] { Math.Abs(x.Debit), Math.Abs(x.Credit), Math.Abs(x.Net) }.Max());
        var height = maximum == 0 ? 0 : Math.Max(2m, Math.Abs(value) / maximum * 100m);
        return $"--bar-height:{height.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

    private decimal GetDistributionTotal()
        => level0BalanceCards.Sum(x => Math.Abs(x.Net));

    private IReadOnlyList<DonutLegendVm> GetLevel0LegendItems()
    {
        var nonZero = level0BalanceCards.Where(x => x.Net != 0m).ToList();
        var total = nonZero.Sum(x => Math.Abs(x.Net));
        return nonZero.Select((item, index) => new DonutLegendVm(
                item.Level0Name,
                GetLevel0PieColor(index),
                total == 0 ? 0 : Math.Abs(item.Net) / total * 100m))
            .ToList();
    }

    private IReadOnlyList<FinancialIndicatorVm> GetFinancialIndicators()
    {
        if (data is null) return [];

        var revenues = GetNamedBalance(true, "إيراد", "ايراد", "دخل", "مبيعات", "revenue");
        var expenses = GetNamedBalance(false, "مصروف", "مصاريف", "تكاليف", "expense");
        var balanceMatch = Math.Max(data.TotalDebit, data.TotalCredit) == 0
            ? 100m
            : Math.Min(data.TotalDebit, data.TotalCredit) / Math.Max(data.TotalDebit, data.TotalCredit) * 100m;
        var expenseRatio = revenues == 0 ? 0 : expenses / Math.Abs(revenues) * 100m;
        var margin = revenues == 0 ? 0 : (revenues - expenses) / Math.Abs(revenues) * 100m;

        return
        [
            new("نسبة توازن المدين والدائن", $"{balanceMatch:0.#}%", "bi-shield-check", balanceMatch >= 99.9m ? "#389b71" : "#d28a25"),
            new("نسبة المصروفات إلى الإيرادات", $"{expenseRatio:0.#}%", "bi-percent", expenseRatio <= 100m ? "#3964df" : "#df574e"),
            new("هامش صافي الفترة", $"{margin:0.#}%", "bi-heart-pulse-fill", margin >= 0 ? "#389b71" : "#df574e"),
            new("إجمالي القيود المسجلة", data.JournalEntriesCount.ToString("N0"), "bi-journal-check", "#8358e8")
        ];
    }

    private sealed record FinancialKpiVm(
        string Title, decimal Value, string Icon, string Color, string Detail,
        string Ratio, string TrendIcon, decimal Progress, string Footnote);

    private sealed record DonutLegendVm(string Name, string Color, decimal Percentage);

    private sealed record FinancialIndicatorVm(string Title, string Value, string Icon, string Color);

    private List<Level0PieSliceVm> GetLevel0PieSlices()
    {
        const double center = 120d;
        const double radius = 110d;
        var balances = level0BalanceCards.Where(x => x.Net != 0m).ToList();
        var total = balances.Sum(x => Math.Abs(x.Net));
        var slices = new List<Level0PieSliceVm>();
        var startAngle = -90d;

        for (var index = 0; index < balances.Count; index++)
        {
            var item = balances[index];
            var sweepAngle = index == balances.Count - 1
                ? 270d - startAngle
                : (double)(Math.Abs(item.Net) / total * 360m);
            var path = sweepAngle >= 359.999d
                ? $"M {SvgNumber(center)} {SvgNumber(center - radius)} A {SvgNumber(radius)} {SvgNumber(radius)} 0 1 1 {SvgNumber(center)} {SvgNumber(center + radius)} A {SvgNumber(radius)} {SvgNumber(radius)} 0 1 1 {SvgNumber(center)} {SvgNumber(center - radius)} Z"
                : BuildPieSlicePath(center, center, radius, startAngle, startAngle + sweepAngle);

            slices.Add(new Level0PieSliceVm(item.Level0Name, item.Net, GetLevel0PieColor(index), path));
            startAngle += sweepAngle;
        }

        return slices;
    }

    private static string GetLevel0PieColor(int index) => Level0PieColors[index % Level0PieColors.Length];

    private static string BuildPieSlicePath(double centerX, double centerY, double radius, double startAngle, double endAngle)
    {
        var start = GetPointOnCircle(centerX, centerY, radius, startAngle);
        var end = GetPointOnCircle(centerX, centerY, radius, endAngle);
        var largeArc = endAngle - startAngle > 180d ? 1 : 0;
        return $"M {SvgNumber(centerX)} {SvgNumber(centerY)} L {SvgNumber(start.X)} {SvgNumber(start.Y)} A {SvgNumber(radius)} {SvgNumber(radius)} 0 {largeArc} 1 {SvgNumber(end.X)} {SvgNumber(end.Y)} Z";
    }

    private static (double X, double Y) GetPointOnCircle(double centerX, double centerY, double radius, double angle)
    {
        var radians = angle * Math.PI / 180d;
        return (centerX + radius * Math.Cos(radians), centerY + radius * Math.Sin(radians));
    }

    private static string SvgNumber(double value)
        => value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);

    private sealed record Level0PieSliceVm(string Name, decimal Value, string Color, string Path);

    private void ShowLevel0PieTooltip(Level0PieSliceVm slice)
        => level0PieTooltip = $"{slice.Name}: {FormatCurrency(slice.Value)}";

    private void HideLevel0PieTooltip()
        => level0PieTooltip = null;

    private string GetLevel1BarStyle(decimal value)
    {
        var maximum = data?.Level1Balances.Count > 0
            ? data.Level1Balances.Max(x => Math.Abs(x.Net))
            : 0;
        var width = maximum == 0 ? 0 : Math.Abs(value) / maximum * 100;
        return $"--level1-bar-width:{width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%;";
    }

