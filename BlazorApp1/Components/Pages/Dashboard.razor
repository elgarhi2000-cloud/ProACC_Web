    private static string GetCategoryCardClass(string key) => key switch
    {
        "assets" => "kpi-success",
        "liabilities" => "kpi-danger",
        "equity" => "kpi-primary",
        "revenues" => "kpi-warning",
        "expenses" => "kpi-neutral",
        _ => "kpi-primary"
    };

    private static string GetCategoryIcon(string key) => key switch
    {
        "assets" => "bi-bank2",
        "liabilities" => "bi-cash-stack",
        "equity" => "bi-pie-chart",
        "revenues" => "bi-graph-up-arrow",
        "expenses" => "bi-graph-down-arrow",
        _ => "bi-diagram-3"
    };

    private static string GetLevel0CardClass(int level0Id)
    {
        var palette = new[] { "kpi-primary", "kpi-success", "kpi-danger", "kpi-warning", "kpi-neutral" };
        var idx = Math.Abs(level0Id) % palette.Length;
        return palette[idx];
    }

    private static string GetLevel0Icon(string level0Name)
    {
        if (string.IsNullOrWhiteSpace(level0Name))
        {
            return "bi-diagram-2";
        }

        var name = level0Name.Trim();

        if (name.Contains("أصول", StringComparison.OrdinalIgnoreCase) || name.Contains("موجود", StringComparison.OrdinalIgnoreCase) || name.Contains("asset", StringComparison.OrdinalIgnoreCase))
            return "bi-bank2";
        if (name.Contains("خصوم", StringComparison.OrdinalIgnoreCase) || name.Contains("التزام", StringComparison.OrdinalIgnoreCase) || name.Contains("liab", StringComparison.OrdinalIgnoreCase))
            return "bi-safe2";
        if (name.Contains("ملكية", StringComparison.OrdinalIgnoreCase) || name.Contains("equity", StringComparison.OrdinalIgnoreCase))
            return "bi-pie-chart";
        if (name.Contains("إيراد", StringComparison.OrdinalIgnoreCase) || name.Contains("ايراد", StringComparison.OrdinalIgnoreCase) || name.Contains("revenue", StringComparison.OrdinalIgnoreCase) || name.Contains("دخل", StringComparison.OrdinalIgnoreCase))
            return "bi-cash-coin";
        if (name.Contains("مصروف", StringComparison.OrdinalIgnoreCase) || name.Contains("expense", StringComparison.OrdinalIgnoreCase) || name.Contains("تكاليف", StringComparison.OrdinalIgnoreCase))
            return "bi-wallet2";

        return "bi-diagram-2";
    }

    private decimal GetNetProfitOrLoss()
    {
        var totalRevenue = level0BalanceCards
            .Where(x => x.Level0Name.Contains("إيراد", StringComparison.OrdinalIgnoreCase)
                        || x.Level0Name.Contains("ايراد", StringComparison.OrdinalIgnoreCase)
                        || x.Level0Name.Contains("revenue", StringComparison.OrdinalIgnoreCase)
                        || x.Level0Name.Contains("دخل", StringComparison.OrdinalIgnoreCase)
                        || x.Level0Name.Contains("مبيعات", StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.Credit - x.Debit);

        var totalExpense = level0BalanceCards
            .Where(x => x.Level0Name.Contains("مصروف", StringComparison.OrdinalIgnoreCase)
                        || x.Level0Name.Contains("مصاريف", StringComparison.OrdinalIgnoreCase)
                        || x.Level0Name.Contains("expense", StringComparison.OrdinalIgnoreCase)
                        || x.Level0Name.Contains("تكاليف", StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.Debit - x.Credit);

        return totalRevenue - totalExpense;
    }

    private static string GetCoverageRatio(decimal debit, decimal credit)
    {
        if (credit == 0)
        {
            return debit == 0 ? "0.00x" : "∞";
        }
        var ratio = debit / credit;
        return $"{ratio:N2}x";
    }

    private void ApplySearch()
    {
        if (data is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(searchText))
        {
            filteredEntries = data.RecentEntries.ToList();
            return;
        }

        var term = searchText.Trim();
        filteredEntries = data.RecentEntries.Where(x =>
                x.GLID.ToString().Contains(term, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrWhiteSpace(x.SourceName) && x.SourceName.Contains(term, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(x.Description) && x.Description.Contains(term, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(x.Info) && x.Info.Contains(term, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrWhiteSpace(x.CardName) && x.CardName.Contains(term, StringComparison.OrdinalIgnoreCase)))
            .ToList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        ApplySearch();
    }
}

