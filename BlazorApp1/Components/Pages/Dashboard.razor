@page "/dashboard"
@layout BlazorApp1.Components.Layout.AccountingLayout
@using BlazorApp1.Services
@using System.Globalization
@inject ISessionService SessionService
@inject IAccountingDataService AccountingDataService

<PageTitle>الرئيسية - النظام المحاسبي</PageTitle>

<div class="dashboard" dir="rtl">
    <div class="welcome-section mb-4 dashboard-hero">
        <div class="hero-copy">
            <div class="hero-kicker"><span></span> ملخص الأداء المالي</div>
            <h2 class="hero-title">مرحباً، @SessionService.CurrentUsername</h2>
            <p class="hero-subtitle">لوحة مؤشرات سريعة لأهم النتائج المالية</p>
        </div>
        <div class="hero-minimal-art" aria-hidden="true">
            <span class="hero-art-grid"></span>
        </div>
        <div class="hero-context-wrap">
            <div class="hero-date" aria-label="تاريخ اليوم">
                <div class="hero-date-heading">
                    <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                    <span>اليوم <strong>@Today.ToString("dddd", ArabicDateCulture)</strong></span>
                    <span class="hero-date-dot" aria-hidden="true"></span>
                </div>
                <time class="hero-date-gregorian" datetime="@Today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@Today.ToString("dd MMMM yyyy", ArabicDateCulture) <small>م</small></time>
                <div class="hero-date-hijri"><i class="bi bi-moon-stars" aria-hidden="true"></i> @Today.ToString("dd MMMM yyyy", HijriDateCulture) هـ</div>
            </div>
            <div class="hero-context" aria-label="بيانات المنشأة والفترة المالية">
                <div class="hero-context-item">
                    <i class="bi bi-building"></i>
                    <div>
                        <span>اسم المنشأة</span>
                        <strong class="hero-company-name" title="@GetCompanyName()">@GetCompanyName()</strong>
                    </div>
                </div>
                <div class="hero-context-item">
                    <i class="bi bi-calendar-range"></i>
                    <div>
                        <span>الفترة المالية</span>
                        <strong>@GetPeriodName()</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    else if (isLoading)
    {
        <div class="alert alert-info">جاري تحميل البيانات...</div>
    }
    else if (data is not null)
    {
        <div class="financial-kpi-grid mb-4">
            @foreach (var item in GetFinancialKpis())
            {
                <article class="financial-kpi-card" style="@GetKpiStyle(item)">
                    <div class="kpi-topline"></div>
                    <div class="financial-kpi-head">
                        <span class="financial-kpi-icon" aria-hidden="true"><i class="bi @item.Icon"></i></span>
                        <span>@item.Title</span>
                    </div>
                    <div class="financial-kpi-amount"><strong>@FormatCompactCurrency(item.Value)</strong><span>ر.س</span></div>
                    <div class="financial-kpi-meta">
                        <span>@item.Detail</span>
                        <strong><i class="bi @item.TrendIcon"></i> @item.Ratio</strong>
                    </div>
                    <div class="financial-kpi-progress"><span></span></div>
                    <small>@item.Footnote</small>
                </article>
            }
        </div>

        <div class="documents-strip mb-4" aria-label="حركة القيود والمستندات">
            <a class="document-summary-item document-receipts" href="/accounting/receipts"><div class="document-summary-icon"><i class="bi bi-receipt"></i></div><div><strong>@data.ReceiptsCount</strong><span>سندات القبض</span></div></a>
            <a class="document-summary-item document-payments" href="/accounting/payments"><div class="document-summary-icon"><i class="bi bi-wallet2"></i></div><div><strong>@data.PaymentsCount</strong><span>سندات الصرف</span></div></a>
            <a class="document-summary-item document-sales" href="/accounting/invoices"><div class="document-summary-icon"><i class="bi bi-file-earmark-text"></i></div><div><strong>@data.SalesInvoicesCount</strong><span>فواتير المبيعات</span></div></a>
            <a class="document-summary-item document-purchases" href="/accounting/purchase-invoices"><div class="document-summary-icon"><i class="bi bi-file-earmark-arrow-down"></i></div><div><strong>@data.PurchaseInvoicesCount</strong><span>فواتير المشتريات</span></div></a>
            <a class="document-summary-item document-journals" href="/accounting/journal-entries"><div class="document-summary-icon"><i class="bi bi-journal-text"></i></div><div><strong>@data.JournalEntriesCount</strong><span>قيود اليومية</span></div></a>
        </div>

        <div class="analytics-grid mb-4">
            <section class="card dashboard-analytics-card performance-card">
                <div class="analytics-card-header">
                    <div><h5><i class="bi bi-bar-chart-line-fill"></i> مقارنة الأداء المالي</h5><p>مقارنة حركة المدين والدائن وصافي الرصيد للحسابات الرئيسية</p></div>
                </div>
                <div class="chart-legend"><span class="legend-debit">المدين</span><span class="legend-credit">الدائن</span><span class="legend-net">صافي الرصيد</span></div>
                @if (level0BalanceCards.Count == 0)
                {
                    <div class="balance-empty">لا توجد بيانات مالية لعرضها.</div>
                }
                else
                {
                    <div class="comparison-chart" role="img" aria-label="مقارنة أرصدة الحسابات الرئيسية">
                        @foreach (var item in GetComparisonBalances())
                        {
                            <div class="comparison-group" title="@item.Level0Name">
                                <div class="comparison-bars">
                                    <span class="comparison-bar debit" style="@GetComparisonBarStyle(item.Debit)" title="مدين: @FormatCurrency(item.Debit)"></span>
                                    <span class="comparison-bar credit" style="@GetComparisonBarStyle(item.Credit)" title="دائن: @FormatCurrency(item.Credit)"></span>
                                    <span class="comparison-bar net @(item.Net < 0 ? "negative" : null)" style="@GetComparisonBarStyle(item.Net)" title="الصافي: @FormatCurrency(item.Net)"></span>
                                </div>
                                <span class="comparison-label">@item.Level0Name</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="card dashboard-analytics-card">
                <div class="analytics-card-header"><div><h5><i class="bi bi-speedometer2"></i> أهم المؤشرات القياسية</h5><p>قراءة سريعة لحالة النشاط المالي</p></div></div>
                <div class="indicator-list">
                    @foreach (var indicator in GetFinancialIndicators())
                    {
                        <div class="indicator-item"><span class="indicator-icon" style="--indicator:@indicator.Color"><i class="bi @indicator.Icon"></i></span><span>@indicator.Title</span><strong style="--indicator:@indicator.Color">@indicator.Value</strong></div>
                    }
                </div>
            </section>
        </div>

        <div class="insights-grid mb-4">
            <section class="card dashboard-analytics-card">
                <div class="analytics-card-header"><div><h5><i class="bi bi-bullseye"></i> أرصدة الحسابات الرئيسية</h5><p>أعلى الحسابات حسب القيمة المطلقة لصافي الرصيد</p></div></div>
                @if (data.Level1Balances.Count == 0) { <div class="balance-empty">لا توجد حسابات في المستوى الأول.</div> }
                else
                {
                    <div class="level1-bar-chart" role="img" aria-label="أرصدة الحسابات الرئيسية">
                        @foreach (var item in data.Level1Balances.Take(6))
                        {
                            <div class="level1-bar-row" title="@($"{item.Level1Name}: {FormatCurrency(item.Net)}")">
                                <div class="level1-bar-label"><span>@item.Level1Name</span><strong>@FormatCompactCurrency(item.Net) ر.س</strong></div>
                                <div class="level1-bar-track"><div class="level1-bar @(item.Net >= 0 ? "is-positive" : "is-negative")" style="@GetLevel1BarStyle(item.Net)"></div></div>
                            </div>
                        }
                    </div>
                }
            </section>
            <section class="card dashboard-analytics-card distribution-card">
                <div class="analytics-card-header"><div><h5><i class="bi bi-pie-chart-fill"></i> توزيع الأرصدة</h5><p>حسب الحسابات الرئيسية</p></div></div>
                @if (level0BalanceCards.Count == 0 || level0BalanceCards.All(x => x.Net == 0m))
                {
                    <div class="balance-empty">لا توجد أرصدة غير صفرية لعرضها.</div>
                }
                else
                {
                    <div class="level0-pie-wrap" role="img" aria-label="توزيع صافي أرصدة الحسابات الرئيسية">
                        <svg class="level0-pie" viewBox="0 0 240 240">
                            @foreach (var slice in GetLevel0PieSlices())
                            {
                                <path class="level0-pie-slice" d="@slice.Path" fill="@slice.Color" tabindex="0"
                                      @onmouseenter="() => ShowLevel0PieTooltip(slice)" @onmouseleave="HideLevel0PieTooltip"
                                      @onfocus="() => ShowLevel0PieTooltip(slice)" @onblur="HideLevel0PieTooltip">
                                    <title>@($"{slice.Name}: {FormatCurrency(slice.Value)}")</title>
                                </path>
                            }
                            <circle cx="120" cy="120" r="68" fill="white"></circle>
                            <text x="120" y="114" text-anchor="middle" class="donut-label">إجمالي الحركة</text>
                            <text x="120" y="137" text-anchor="middle" class="donut-value">@FormatCompactNumber(GetDistributionTotal())</text>
                        </svg>
                        @if (!string.IsNullOrWhiteSpace(level0PieTooltip)) { <div class="level0-pie-tooltip">@level0PieTooltip</div> }
                    </div>
                    <div class="donut-legend">
                        @foreach (var item in GetLevel0LegendItems())
                        {
                            <span><i style="background:@item.Color"></i>@item.Name <strong>@item.Percentage.ToString("0.#")%</strong></span>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 modern-card">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0">
                        <h5 class="mb-0 dashboard-card-title"><span class="dashboard-title-icon title-accounts" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>أرصدة الحسابات الرئيسية</h5>
                    </div>
                    <div class="card-body pt-3">
                        @if (data.Level1Balances.Count == 0)
                        {
                            <div class="balance-empty">لا توجد حسابات في جدول Level1.</div>
                        }
                        else
                        {
                            <div class="table-responsive balance-table-wrap">
                                <table class="table table-hover align-middle balance-table mb-0">
                                    <thead>
                                    <tr>
                                        <th>الحساب</th>
                                        <th>مدين</th>
                                        <th>دائن</th>
                                        <th>الصافي</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in data.Level1Balances)
                                    {
                                        <tr>
                                            <td>
                                                <span class="balance-code">@item.Level1Id</span>
                                                <span class="balance-name">@item.Level1Name</span>
                                            </td>
                                            <td class="text-success text-nowrap">@FormatCurrency(item.Debit)</td>
                                            <td class="text-danger text-nowrap">@FormatCurrency(item.Credit)</td>
                                            <td class="fw-bold text-nowrap @(item.Net >= 0 ? "text-primary" : "text-danger")">@FormatCurrency(item.Net)</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100 modern-card">
                    <div class="card-header bg-transparent border-0 pt-3 pb-0">
                        <h5 class="mb-0 dashboard-card-title"><span class="dashboard-title-icon title-important" aria-hidden="true"><i class="bi bi-star-fill"></i></span>أرصدة الحسابات الهامة</h5>
                    </div>
                    <div class="card-body pt-3">
                        @if (data.ChartAccountBalances.Count == 0)
                        {
                            <div class="balance-empty">لا توجد أرصدة حسابات هامة لعرضها.</div>
                        }
                        else
                        {
                            <div class="table-responsive balance-table-wrap">
                                <table class="table table-hover align-middle balance-table mb-0">
                                    <thead>
                                    <tr>
                                        <th>الحساب</th>
                                        <th>مدين</th>
                                        <th>دائن</th>
                                        <th>الصافي</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var item in data.ChartAccountBalances)
                                    {
                                        <tr>
                                            <td>
                                                <span class="balance-code">@item.AccountId</span>
                                                <span class="balance-name">@item.AccountName</span>
                                            </td>
                                            <td class="text-success text-nowrap">@FormatCurrency(item.Debit)</td>
                                            <td class="text-danger text-nowrap">@FormatCurrency(item.Credit)</td>
                                            <td class="fw-bold text-nowrap @(item.Net >= 0 ? "text-primary" : "text-danger")">@FormatCurrency(item.Net)</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm modern-card">
            <div class="card-header bg-transparent border-0 pt-3 pb-0">
                <h5 class="mb-0 dashboard-card-title"><span class="dashboard-title-icon title-entries" aria-hidden="true"><i class="bi bi-journal-text"></i></span>آخر القيود المسجلة</h5>
            </div>
            <div class="card-body">
                <div class="section-search-bar">
                    <input aria-label="ابحث في العمليات الأخيرة" type="search" class="form-control section-search-input" value="@searchText" @oninput="OnSearchInput" placeholder="ابحث في العمليات الأخيرة" />
                    <button class="btn section-search-btn" @onclick="ApplySearch"><i class="bi bi-search me-1"></i>بحث</button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                        <tr>
                            <th>رقم القيد</th>
                            <th>التاريخ</th>
                            <th>المصدر</th>
                            <th>الوصف</th>
                            <th>المدين</th>
                            <th>الدائن</th>
                            <th class="text-nowrap">المستخدم</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in filteredEntries)
                        {
                            <tr>
                                <td>#@item.GLID</td>
                                <td>@(item.Date?.ToString("yyyy/MM/dd") ?? "-")</td>
                                <td>@item.SourceName</td>
                                <td>@item.Description</td>
                                <td class="text-success">@FormatCurrency(item.Debit)</td>
                                <td class="text-danger">@FormatCurrency(item.Credit)</td>
                                <td class="text-nowrap"><bdi>@(string.IsNullOrWhiteSpace(item.Info) ? "-" : item.Info)</bdi></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    }
</div>

<style>
    .dashboard-hero {
        min-height: 156px;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 28px;
        overflow: hidden;
        background: linear-gradient(135deg, #1f3a8a 0%, #3b82f6 100%);
        color: #fff;
        border-radius: 18px;
        padding: 24px 30px;
    }

    .dashboard-hero::before {
        content: '';
        width: 150px;
        height: 150px;
        position: absolute;
        right: -68px;
        bottom: -96px;
        background: transparent;
        border: 1px solid rgba(255, 255, 255, .09);
        border-radius: 50%;
    }

    .dashboard-hero::after {
        width: 190px;
        height: 190px;
        left: -74px;
        top: -108px;
        background: transparent;
        border: 24px solid rgba(255, 255, 255, .045);
    }

    .hero-copy,
    .hero-context-wrap {
        position: relative;
        z-index: 2;
    }

    .hero-copy {
        min-width: 280px;
    }

    .hero-kicker {
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: rgba(255, 255, 255, .72);
        font-size: .72rem;
        font-weight: 700;
    }

    .hero-kicker span {
        width: 7px;
        height: 7px;
        display: block;
        background: #8eeac8;
        border: 2px solid rgba(255, 255, 255, .26);
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(142, 234, 200, .1);
    }

    .hero-title {
        font-size: 1.7rem;
        font-weight: 800;
        margin: 0;
    }

    .hero-subtitle {
        margin: 6px 0 0;
        color: rgba(255, 255, 255, .82) !important;
        font-size: .94rem;
    }

    .hero-minimal-art {
        width: auto;
        height: auto;
        position: absolute;
        inset: 0;
        z-index: 1;
        opacity: .62;
        pointer-events: none;
    }

    .hero-minimal-art::before,
    .hero-minimal-art::after {
        content: '';
        position: absolute;
        border-radius: 50%;
    }

    .hero-minimal-art::before {
        width: 360px;
        height: 360px;
        left: 25%;
        top: -275px;
        border: 1px solid rgba(255, 255, 255, .075);
    }

    .hero-minimal-art::after {
        width: 240px;
        height: 240px;
        right: 34%;
        bottom: -205px;
        border: 1px solid rgba(142, 234, 200, .065);
    }

    .hero-art-grid {
        position: absolute;
        inset: 10px 0;
        opacity: .2;
        background-image: radial-gradient(circle, rgba(255, 255, 255, .55) 1px, transparent 1.2px);
        background-size: 18px 18px;
        -webkit-mask-image: linear-gradient(90deg, transparent 3%, #000 18%, #000 82%, transparent 97%);
        mask-image: linear-gradient(90deg, transparent 3%, #000 18%, #000 82%, transparent 97%);
    }

    .hero-context {
        width: min(460px, 100%);
        min-width: 0;
        padding: 7px;
        display: grid;
        grid-template-columns: minmax(0, 1.8fr) minmax(130px, .7fr);
        align-items: stretch;
        gap: 0;
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(255, 255, 255, .13), rgba(255, 255, 255, .075));
        border: 1px solid rgba(255, 255, 255, .23);
        border-radius: 15px;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .1), 0 10px 24px rgba(39, 28, 133, .11);
        backdrop-filter: blur(9px);
    }

    .hero-context-wrap {
        min-width: 0;
        display: flex;
        align-items: stretch;
        gap: 10px;
    }

    .hero-context-item {
        min-width: 0;
        padding: 8px 11px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .hero-context-item i {
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        flex: 0 0 36px;
        color: #fff;
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .13);
        border-radius: 10px;
        font-size: .92rem;
    }

    .hero-context-item div {
        min-width: 0;
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    .hero-context-item span {
        margin-bottom: 3px;
        color: rgba(255, 255, 255, .66);
        font-size: .67rem;
        font-weight: 650;
    }

    .hero-context-item strong {
        max-width: 100%;
        overflow: hidden;
        color: #fff;
        font-size: .86rem;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .kpi-card {
        border-radius: 16px;
        color: #fff;
        min-height: 124px;
    }

    .kpi-primary { background: linear-gradient(135deg, #3b82f6, #2563eb); }
    .kpi-success { background: linear-gradient(135deg, #22c55e, #16a34a); }
    .kpi-danger { background: linear-gradient(135deg, #ef4444, #dc2626); }
    .kpi-warning { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .kpi-neutral { background: linear-gradient(135deg, #64748b, #475569); }

    .kpi-card .kpi-value {
        font-size: clamp(1.05rem, 1.9vw, 1.45rem);
        font-weight: 800;
        line-height: 1.25;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .kpi-card .kpi-label {
        color: rgba(255, 255, 255, .92);
        font-weight: 700;
        font-size: clamp(.76rem, 1.1vw, .92rem);
        line-height: 1.3;
        word-break: break-word;
        overflow-wrap: anywhere;
    }

    .kpi-card i {
        opacity: .95;
        flex-shrink: 0;
    }

    .kpi-content-wrap {
        min-width: 0;
        flex: 1;
        padding-left: 8px;
    }

    .kpi-grid-row {
        align-items: stretch;
    }

    .journal-count-card,
    .documents-summary-card {
        min-height: 124px;
        border-radius: 16px;
    }

    .documents-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        align-items: stretch;
        gap: 10px;
        padding: 12px;
    }

    .document-summary-item {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px;
        border-radius: 12px;
        background: #f8fafc;
    }

    .document-summary-item > div:last-child {
        min-width: 0;
        display: flex;
        flex-direction: column;
        line-height: 1.25;
    }

    .document-summary-item strong {
        color: #0f172a;
        font-size: 1.15rem;
        font-weight: 800;
    }

    .document-summary-item span {
        color: #64748b;
        font-size: .78rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .document-summary-icon {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        flex: 0 0 34px;
        border-radius: 10px;
        font-size: 1rem;
    }

    .document-receipts .document-summary-icon { color: #0f9f76; background: #e7f7f2; }
    .document-payments .document-summary-icon { color: #e0445e; background: #fdecef; }
    .document-sales .document-summary-icon { color: #5b4bdb; background: #efedff; }
    .document-purchases .document-summary-icon { color: #d98a16; background: #fff5e6; }

    .dashboard-section-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #334155;
        font-size: .96rem;
        font-weight: 800;
    }

    .dashboard-section-heading i {
        color: #4f46e5;
    }

    .modern-card {
        border-radius: 16px;
    }

    .level0-pie-wrap {
        position: relative;
        display: flex;
